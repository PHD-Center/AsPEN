---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import { WORKER_URL } from "../../data/site-config";

// Leadership-meeting minutes. The files live in the private members repo
// under leadership/minutes/YYYY-MM-DD-slug.html (one HTML fragment per
// meeting, first heading = the meeting title). The worker only lists and
// serves that folder to members flagged `leadership`; this page is just
// the viewer, so it carries no content of its own.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout
  title="Leadership meetings · AsPEN members"
  description="Minutes and actions from AsPEN leadership meetings."
>
  <PageHeader
    eyebrow="Members → Leadership"
    title="Leadership meetings"
    description="Minutes and actions for the AsPEN leadership team."
  />

  <section class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-10 space-y-6">
    <p class="text-sm">
      <a class="text-brand-700 hover:underline font-semibold" href={`${base}/members/`}>← Members area</a>
    </p>

    <div data-state="loading" class="text-sm text-slate-600 italic">
      Loading…
    </div>

    <div data-state="signed-out" class="hidden border border-slate-200 rounded-lg p-6 bg-slate-50">
      <p class="text-sm text-slate-700">
        You're not signed in. <a class="text-brand-700 hover:underline font-semibold" href={`${base}/members/login`}>Sign in →</a>
      </p>
    </div>

    <div data-state="forbidden" class="hidden border border-slate-200 rounded-lg p-6 bg-slate-50">
      <p class="text-sm font-semibold text-slate-800">This page is for the AsPEN leadership team.</p>
      <p class="mt-2 text-sm text-slate-600 leading-relaxed">
        Minutes here are shared with the Chair, Chair-Elect, Immediate Past Chair and office leads. If you expected access, ask the Chair.
      </p>
    </div>

    <div data-state="empty" class="hidden border border-slate-200 rounded-lg p-6 bg-slate-50">
      <p class="text-sm text-slate-700">No minutes yet.</p>
    </div>

    <div data-state="error" class="hidden border border-rose-300 bg-rose-50 rounded-lg p-6">
      <p class="text-sm text-rose-800" data-error-msg></p>
    </div>

    <div data-state="ready" class="hidden grid gap-6 md:grid-cols-[14rem_1fr] items-start">
      <nav aria-label="Meetings" class="md:sticky md:top-24">
        <p class="text-xs uppercase tracking-widest text-brand-600 font-semibold mb-2">Meetings</p>
        <ul data-minutes-nav class="space-y-1"></ul>
      </nav>
      <div class="min-w-0 space-y-3">
        <div class="flex flex-wrap justify-end gap-2">
          <!-- Shown to admins only: the draft needs the member list for its recipients. -->
          <button type="button" data-email-draft hidden
                  class="inline-flex items-center gap-2 border border-slate-300 bg-white text-slate-700 hover:border-brand-500 hover:text-brand-700 font-semibold px-3 py-1.5 rounded text-sm transition disabled:opacity-60 disabled:cursor-wait [&[hidden]]:hidden">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><polyline points="3 7 12 13 21 7"/></svg>
            <span>Draft email</span>
          </button>
          <button type="button" data-export-word data-logo={`${base}/images/AsPenLogo.png`}
                  class="inline-flex items-center gap-2 border border-slate-300 bg-white text-slate-700 hover:border-brand-500 hover:text-brand-700 font-semibold px-3 py-1.5 rounded text-sm transition disabled:opacity-60 disabled:cursor-wait">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            <span data-export-label>Download as Word</span>
          </button>
        </div>
        <article data-minutes-body class="min-w-0 border border-slate-200 rounded-2xl bg-white shadow-sm px-6 py-6 sm:px-8"></article>
      </div>
    </div>

    <!-- Email draft. Nothing is sent from the site: this fills a draft the
         chair opens in their own mail app, or copies. -->
    <dialog data-email-dialog class="m-auto w-[min(44rem,calc(100vw-2rem))] max-h-[calc(100vh-2rem)] overflow-y-auto rounded-2xl border border-slate-200 bg-white p-0 shadow-xl backdrop:bg-slate-900/40">
      <form method="dialog" class="p-5 sm:p-6 space-y-4">
        <div class="flex items-start justify-between gap-4">
          <div>
            <h2 class="text-lg font-bold text-slate-900">Email the minutes</h2>
            <p class="mt-1 text-xs text-slate-500 leading-relaxed">Nothing is sent from here. This prepares a draft for you to review and send from your own mail app.</p>
          </div>
          <button type="submit" class="shrink-0 -mt-1 text-2xl leading-none text-slate-400 hover:text-slate-700" aria-label="Close">&times;</button>
        </div>

        <div>
          <div class="flex items-center justify-between">
            <label for="email-to" class="text-[11px] uppercase tracking-widest text-brand-700 font-semibold">To</label>
            <button type="button" data-copy="to" class="text-xs font-semibold text-brand-700 hover:underline">Copy</button>
          </div>
          <textarea id="email-to" data-email-to rows="2" readonly class="mt-1 w-full border border-slate-300 rounded px-3 py-2 text-sm text-slate-800 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 bg-slate-50"></textarea>
          <p data-email-to-note class="mt-1 text-[11px] text-slate-500"></p>
        </div>

        <div>
          <div class="flex items-center justify-between">
            <label for="email-subject" class="text-[11px] uppercase tracking-widest text-brand-700 font-semibold">Subject</label>
            <button type="button" data-copy="subject" class="text-xs font-semibold text-brand-700 hover:underline">Copy</button>
          </div>
          <input id="email-subject" data-email-subject type="text" class="mt-1 w-full border border-slate-300 rounded px-3 py-2 text-sm text-slate-800 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500" />
        </div>

        <div>
          <div class="flex items-center justify-between">
            <label for="email-body" class="text-[11px] uppercase tracking-widest text-brand-700 font-semibold">Message</label>
            <button type="button" data-copy="body" class="text-xs font-semibold text-brand-700 hover:underline">Copy</button>
          </div>
          <textarea id="email-body" data-email-body rows="13" class="mt-1 w-full border border-slate-300 rounded px-3 py-2 text-sm text-slate-800 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 leading-relaxed"></textarea>
          <label class="mt-2 flex items-center gap-2 text-sm text-slate-700">
            <input type="checkbox" data-email-full class="rounded border-slate-400 text-brand-700 focus:ring-brand-500" />
            Include the full minutes, not only the actions
          </label>
          <p class="mt-1 text-[11px] text-slate-500">Ticking or unticking this rewrites the message, so do it before editing.</p>
        </div>

        <p data-email-long hidden class="text-xs text-amber-700 leading-relaxed">This draft is long. A desktop mail app may cut it short when opened this way. Open in Gmail and Copy all keep the whole text.</p>

        <div class="flex flex-wrap items-center justify-end gap-2 pt-1">
          <span data-email-msg class="mr-auto text-xs text-slate-500" role="status" aria-live="polite"></span>
          <button type="button" data-copy="all" class="inline-flex items-center gap-2 border border-slate-300 bg-white text-slate-700 hover:border-brand-500 hover:text-brand-700 font-semibold px-3 py-1.5 rounded text-sm transition disabled:opacity-60 disabled:cursor-wait">Copy all</button>
          <a data-email-open href="#" class="inline-flex items-center gap-2 border border-slate-300 bg-white text-slate-700 hover:border-brand-500 hover:text-brand-700 font-semibold px-3 py-1.5 rounded text-sm transition">Open in mail app</a>
          <a data-email-gmail href="#" target="_blank" rel="noopener" class="inline-flex items-center gap-2 bg-brand-700 hover:bg-brand-900 text-white font-semibold px-4 py-1.5 rounded text-sm transition">Open in Gmail</a>
        </div>
      </form>
    </dialog>
  </section>

  <style>
    /* The minutes arrive as plain HTML fragments; style their elements here. */
    [data-minutes-body] :global(h1) { font-size: 1.5rem; line-height: 1.25; font-weight: 700; color: #0f172a; }
    [data-minutes-body] :global(h2) { margin-top: 2rem; font-size: 1.0625rem; font-weight: 700; color: #0f172a; border-bottom: 1px solid #e2e8f0; padding-bottom: 0.375rem; }
    [data-minutes-body] :global(h3) { margin-top: 1.25rem; font-size: 0.9375rem; font-weight: 600; color: #1e293b; }
    [data-minutes-body] :global(p) { margin-top: 0.75rem; font-size: 0.9375rem; line-height: 1.65; color: #334155; }
    [data-minutes-body] :global(ul), [data-minutes-body] :global(ol) { margin-top: 0.75rem; padding-left: 1.5rem; font-size: 0.9375rem; line-height: 1.65; color: #334155; }
    [data-minutes-body] :global(ul) { list-style: disc; }
    [data-minutes-body] :global(ol) { list-style: decimal; }
    [data-minutes-body] :global(li + li) { margin-top: 0.375rem; }
    [data-minutes-body] :global(dl) { margin-top: 0.75rem; display: grid; grid-template-columns: max-content 1fr; column-gap: 1rem; row-gap: 0.25rem; font-size: 0.9375rem; color: #334155; }
    [data-minutes-body] :global(dt) { font-weight: 600; color: #0f172a; }
    [data-minutes-body] :global(table) { margin-top: 1rem; width: 100%; border-collapse: collapse; font-size: 0.875rem; }
    [data-minutes-body] :global(th), [data-minutes-body] :global(td) { text-align: left; vertical-align: top; padding: 0.5rem 0.625rem; border-bottom: 1px solid #e2e8f0; }
    [data-minutes-body] :global(th) { font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.1em; color: #475569; background: #f8fafc; }
    [data-minutes-body] :global(strong) { font-weight: 600; color: #0f172a; }
    [data-minutes-body] :global(a) { color: #1d4ed8; text-decoration: underline; }
    [data-minutes-body] :global(.meta) { margin-top: 0.5rem; font-size: 0.875rem; color: #64748b; }
  </style>

  <script is:inline define:vars={{ WORKER_URL }}>
    (() => {
      const setState = (name) => {
        document.querySelectorAll("[data-state]").forEach((el) => {
          el.classList.toggle("hidden", el.dataset.state !== name);
        });
      };
      const setError = (msg) => {
        document.querySelector("[data-error-msg]").textContent = msg;
        setState("error");
      };
      const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));

      const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
      const dateOf = (path) => {
        const m = path.match(/(\d{4})-(\d{2})-(\d{2})/);
        if (!m) return "";
        return `${parseInt(m[3], 10)} ${MONTHS[parseInt(m[2], 10) - 1]} ${m[1]}`;
      };
      const slugTitle = (path) => {
        const name = (path.split("/").pop() || "").replace(/\.html$/, "").replace(/^\d{4}-\d{2}-\d{2}-?/, "");
        return name ? name.charAt(0).toUpperCase() + name.slice(1).replace(/-/g, " ") : "Minutes";
      };

      const nav = document.querySelector("[data-minutes-nav]");
      const body = document.querySelector("[data-minutes-body]");
      let docs = [];

      const show = (i) => {
        body.innerHTML = docs[i].html;
        body.dataset.docId = docs[i].id;
        nav.querySelectorAll("button").forEach((b, j) => {
          b.classList.toggle("bg-brand-50", j === i);
          b.classList.toggle("text-brand-800", j === i);
          b.classList.toggle("font-semibold", j === i);
          b.setAttribute("aria-current", j === i ? "page" : "false");
        });
        if (history.replaceState) history.replaceState(null, "", "#" + docs[i].id);
      };

      const refresh = async () => {
        try {
          const meR = await fetch(`${WORKER_URL}/api/me`, { credentials: "include" });
          if (!meR.ok) return setState("signed-out");
          const me = await meR.json();
          if (!me?.member?.isLeadership) return setState("forbidden");

          // The email draft takes its recipients from the member list, which
          // only admins can read, so only admins get the button.
          const emailBtn = document.querySelector("[data-email-draft]");
          if (emailBtn && me.member.isAdmin) {
            emailBtn.hidden = false;
            emailBtn.dataset.sender = me.member.name || "";
            emailBtn.dataset.self = String(me.member.email || "").toLowerCase();
          }

          const listR = await fetch(`${WORKER_URL}/api/list/leadership`, { credentials: "include" });
          if (listR.status === 401) return setState("signed-out");
          if (listR.status === 403) return setState("forbidden");
          if (!listR.ok) return setError("Couldn't load the minutes (" + listR.status + ").");
          const data = await listR.json();
          const files = ((data && data.files) || [])
            .filter((f) => /^leadership\/minutes\/.+\.html$/.test(f.path))
            .sort((a, b) => b.path.localeCompare(a.path)); // newest first by date prefix
          if (files.length === 0) return setState("empty");

          docs = await Promise.all(files.map(async (f) => {
            const r = await fetch(`${WORKER_URL}/api/content/${f.path}`, { credentials: "include" });
            const html = r.ok ? await r.text() : `<p>Couldn't load ${esc(f.path)} (${r.status}).</p>`;
            const h1 = new DOMParser().parseFromString(html, "text/html").querySelector("h1");
            return {
              id: (f.path.split("/").pop() || "").replace(/\.html$/, ""),
              date: dateOf(f.path),
              title: (h1 && h1.textContent.trim()) || slugTitle(f.path),
              html,
            };
          }));

          nav.innerHTML = docs.map((d, i) => `
            <li>
              <button type="button" data-i="${i}" class="w-full text-left rounded-lg px-3 py-2 text-sm text-slate-700 hover:bg-slate-50 transition">
                <span class="block text-[11px] uppercase tracking-wider text-slate-500">${esc(d.date)}</span>
                <span class="block leading-snug">${esc(d.title)}</span>
              </button>
            </li>`).join("");
          nav.addEventListener("click", (e) => {
            const b = e.target.closest("button[data-i]");
            if (b) show(parseInt(b.dataset.i, 10));
          });

          const wanted = location.hash.slice(1);
          const start = Math.max(0, docs.findIndex((d) => d.id === wanted));
          setState("ready");
          show(start);
        } catch {
          setError("Network error — try again.");
        }
      };
      refresh();
    })();
  </script>

  <script>
    import { WORKER_URL } from "../../data/site-config";
    import { buildEmailDraft, gmailHref, mailtoHref } from "../../scripts/minutes-email";

    // Email draft: recipients are the other members with leadership access.
    const emailBtn = document.querySelector<HTMLButtonElement>("[data-email-draft]");
    const dlg = document.querySelector<HTMLDialogElement>("[data-email-dialog]");
    if (emailBtn && dlg) {
      const pick = <T extends HTMLElement>(sel: string) => dlg.querySelector<T>(sel)!;
      const toEl = pick<HTMLTextAreaElement>("[data-email-to]");
      const toNote = pick("[data-email-to-note]");
      const subjEl = pick<HTMLInputElement>("[data-email-subject]");
      const bodyEl = pick<HTMLTextAreaElement>("[data-email-body]");
      const fullEl = pick<HTMLInputElement>("[data-email-full]");
      const longEl = pick("[data-email-long]");
      const openEl = pick<HTMLAnchorElement>("[data-email-open]");
      const gmailEl = pick<HTMLAnchorElement>("[data-email-gmail]");
      const msgEl = pick("[data-email-msg]");
      let recipients: { name: string; email: string }[] = [];

      const minutes = () => document.querySelector<HTMLElement>("[data-minutes-body]");
      const refreshLink = () => {
        const href = mailtoHref(recipients.map((r) => r.email), subjEl.value, bodyEl.value);
        openEl.href = href;
        gmailEl.href = gmailHref(recipients.map((r) => r.email), subjEl.value, bodyEl.value);
        // Windows hands mailto: links to the mail app through a command line
        // of about 2,000 characters; past that the draft can arrive cut short.
        longEl.hidden = href.length <= 1900;
      };
      const regenerate = () => {
        const body = minutes();
        if (!body) return;
        const draft = buildEmailDraft(body, {
          id: body.dataset.docId || "",
          sender: emailBtn.dataset.sender || "",
          pageUrl: `${location.origin}${location.pathname}#${body.dataset.docId || ""}`,
          full: fullEl.checked,
        });
        subjEl.value = draft.subject;
        bodyEl.value = draft.body;
        refreshLink();
      };

      emailBtn.addEventListener("click", async () => {
        const body = minutes();
        if (!body || !body.children.length) return;
        emailBtn.disabled = true;
        try {
          const r = await fetch(`${WORKER_URL}/api/admin/members`, { credentials: "include" });
          const data = r.ok ? await r.json() : null;
          if (!data || !data.ok || !Array.isArray(data.members)) throw new Error(`member list ${r.status}`);
          const self = emailBtn.dataset.self || "";
          recipients = (data.members as { name?: string; email: string; status?: string; leadership?: boolean }[])
            .filter((m) => m.leadership === true && m.status === "active" && String(m.email).toLowerCase() !== self)
            .map((m) => ({ name: m.name || m.email, email: m.email }))
            .sort((a, b) => a.name.localeCompare(b.name));
          toEl.value = recipients.map((p) => `${p.name} <${p.email}>`).join(", ");
          toNote.textContent = recipients.length
            ? `${recipients.length} ${recipients.length === 1 ? "person has" : "people have"} access to the leadership minutes besides you.`
            : "Nobody else has access to the leadership minutes yet.";
          fullEl.checked = false;
          msgEl.textContent = "";
          regenerate();
          dlg.showModal();
        } catch (err) {
          console.error(err);
          alert("Couldn't prepare the email draft.");
        } finally {
          emailBtn.disabled = false;
        }
      });

      fullEl.addEventListener("change", regenerate);
      subjEl.addEventListener("input", refreshLink);
      bodyEl.addEventListener("input", refreshLink);

      dlg.addEventListener("click", async (e) => {
        const b = (e.target as HTMLElement).closest<HTMLElement>("[data-copy]");
        if (!b) return;
        const what = b.dataset.copy;
        const text =
          what === "to" ? toEl.value
          : what === "subject" ? subjEl.value
          : what === "body" ? bodyEl.value
          : `To: ${toEl.value}\nSubject: ${subjEl.value}\n\n${bodyEl.value}`;
        try {
          await navigator.clipboard.writeText(text);
          msgEl.textContent = "Copied.";
        } catch {
          msgEl.textContent = "Couldn't copy. Select the text and copy it by hand.";
        }
      });
    }

    // Word export. The converter and the docx library load on first click.
    const btn = document.querySelector<HTMLButtonElement>("[data-export-word]");
    const label = btn?.querySelector<HTMLElement>("[data-export-label]");
    btn?.addEventListener("click", async () => {
      const body = document.querySelector<HTMLElement>("[data-minutes-body]");
      if (!body || !body.children.length) return;
      btn.disabled = true;
      if (label) label.textContent = "Preparing…";
      try {
        const { exportMinutes } = await import("../../scripts/minutes-docx");
        await exportMinutes(body, { id: body.dataset.docId || "", logoUrl: btn.dataset.logo || "" });
      } catch (err) {
        console.error(err);
        alert("Couldn't create the Word file.");
      } finally {
        btn.disabled = false;
        if (label) label.textContent = "Download as Word";
      }
    });
  </script>
</BaseLayout>
