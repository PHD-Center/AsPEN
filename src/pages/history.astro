---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import publications from "../data/publications.json";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Milestones. Publication years are read back from publications.json by PMID so
// the timeline can't drift from the Publications page.
const pmidYear = (pmid: string): number | null =>
  (publications as { pmid?: string; year?: number }[]).find((p) => p.pmid === pmid)?.year ?? null;

const milestones: { year: string; title: string; body: string }[] = [
  {
    year: "2012",
    title: "AsPEN is founded",
    body: "Established in April 2012 as a Special Interest Group of the International Society for Pharmacoepidemiology (ISPE), to support multi-national database research across the Asia-Pacific.",
  },
  {
    year: String(pmidYear("23653370") ?? 2013),
    title: "The founding paper",
    body: "The network and its approach to rapid, multi-country adverse drug event assessment are described in print, alongside the first Prescription Sequence Symmetry Analysis (PSSA) studies.",
  },
  {
    year: String(pmidYear("26133022") ?? 2015),
    title: "Mapping the region's databases",
    body: "A survey of population-level databases across the Asia-Pacific becomes the reference for what data exist, where, and on what terms; it still anchors the Databases page today.",
  },
  {
    year: String(pmidYear("30100761") ?? 2018),
    title: "A common data model",
    body: "Harmonising site-level data structures lets a single protocol run locally at each site and the estimates be pooled centrally.",
  },
  {
    year: String(pmidYear("38146486") ?? 2023),
    title: "NeuroGEN",
    body: "The data infrastructure extends beyond Asia, spanning partner databases across Oceania, Europe, and North America.",
  },
  {
    year: "2026",
    title: "A new home",
    body: "The WordPress site is retired for a static, open-source rebuild: an interactive database catalogue, themed publications, and a members' area.",
  },
];

// The archived snapshot this reconstruction is based on.
const SNAPSHOT_DATE = "7 December 2019";
const SNAPSHOT_URL =
  "https://web.archive.org/web/20191207010519/https://www.aspensig.asia/";
---

<BaseLayout
  title="History · AsPEN"
  description="AsPEN from its founding in 2012 to today, including the site that came before this one."
>
  <PageHeader
    eyebrow="2012 to today"
    title="History"
    description="AsPEN has been running longer than most of the databases it studies. Here is where it started, and the site that carried it for a decade."
  />

  <!-- ================= The reveal ================= -->
  <section class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-14">
    <h2 class="text-xs uppercase tracking-widest text-brand-600 font-semibold mb-3">Then and now</h2>
    <p class="text-slate-600 max-w-2xl leading-relaxed mb-8">
      For over a decade AsPEN lived at this address on WordPress. The reconstruction below is
      built from the Internet Archive's snapshot of {SNAPSHOT_DATE}, down to the masthead and
      the tiled background.
    </p>

    <!-- Stage holds both windows; the old one hands over to the new one. -->
    <div data-stage class="relative [perspective:1800px]">
      <!-- ---------- OLD SITE ---------- -->
      <div data-old-window class="relative origin-top will-change-transform">
        <div class="rounded-t-lg overflow-hidden border border-slate-300 shadow-2xl">
          <!-- period browser chrome -->
          <div class="bg-gradient-to-b from-slate-200 to-slate-300 border-b border-slate-400/60 px-3 py-2">
            <div class="flex items-center gap-2">
              <div class="flex gap-1.5 shrink-0" aria-hidden="true">
                <span class="w-3 h-3 rounded-full bg-red-400 border border-red-500/40"></span>
                <span class="w-3 h-3 rounded-full bg-amber-400 border border-amber-500/40"></span>
                <span class="w-3 h-3 rounded-full bg-green-400 border border-green-500/40"></span>
              </div>
              <div class="flex-1 flex items-center gap-2 bg-white/90 border border-slate-400/50 rounded px-2 py-1 min-w-0">
                <span class="text-[10px] font-bold text-red-600 whitespace-nowrap flex items-center gap-1">
                  <span aria-hidden="true">⚠</span> Not secure
                </span>
                <span class="text-[11px] text-slate-600 truncate font-mono">www.aspensig.asia</span>
              </div>
            </div>
          </div>

          <!-- the old cover itself -->
          <div
            class="relative"
            style={`background-color:#f4f4f4; background-image:url('${base}/images/history/old-bg-tile.png'); background-repeat:repeat;`}
          >
            <div class="bg-white/85 px-4 sm:px-8 pt-6 pb-0">
              <img
                src={`${base}/images/history/old-masthead.png`}
                alt="Asian Pharmacoepidemiology Network; A Special Interest Group of the International Society for Pharmacoepidemiology"
                class="w-full max-w-3xl mx-auto"
              />
            </div>

            <!-- old bootstrap-era nav -->
            <div class="bg-[#5a5a5a] text-white text-[11px] sm:text-xs">
              <div class="max-w-4xl mx-auto flex flex-wrap items-center justify-center gap-x-6 gap-y-1 px-4 py-2.5 font-semibold tracking-wide">
                <span>About US</span>
                <span>National Groups and Contact Persons</span>
                <span>Activities</span>
                <span>Publications</span>
                <span>Related Links</span>
              </div>
            </div>

            <div class="max-w-4xl mx-auto px-4 sm:px-8 py-6">
              <img
                src={`${base}/images/history/old-banner.jpg`}
                alt="AsPEN members at an ICPE poster session"
                class="w-full rounded-sm border border-slate-300"
              />
              <p class="mt-2 text-center text-[11px] text-slate-500 italic">AsPen Photo</p>

              <h3 class="mt-6 text-lg font-bold text-slate-800" style="font-family:Georgia,serif;">About AsPEN</h3>
              <p class="mt-1 text-sm font-bold text-slate-700" style="font-family:Georgia,serif;">What is AsPEN?</p>
              <p class="mt-2 text-[13px] text-slate-600 leading-relaxed" style="font-family:Georgia,serif;">
                The Asian Pharmacoepidemiology Network, or AsPEN, is a multi-national research
                network which was formed to provide a mechanism to support the conduct of
                pharmaco-epidemiological research and to facilitate the prompt identification
                and validation of emerging safety issues among the Asian countries.
              </p>
              <p class="mt-4 text-[13px] text-slate-500" style="font-family:Georgia,serif;">1. The History of AsPEN</p>
            </div>
          </div>
        </div>

        <!-- glitch/scanline overlay, only visible during the handover -->
        <div data-scanlines class="pointer-events-none absolute inset-0 opacity-0 rounded-t-lg overflow-hidden">
          <div class="absolute inset-0" style="background:repeating-linear-gradient(to bottom, rgba(0,0,0,.35) 0 2px, transparent 2px 4px);"></div>
          <div data-sweep class="absolute inset-x-0 h-24 bg-gradient-to-b from-transparent via-white/80 to-transparent"></div>
        </div>
      </div>

      <!-- ---------- NEW SITE ---------- -->
      <div
        data-new-window
        class="absolute inset-0 opacity-0 pointer-events-none origin-center will-change-transform"
        aria-hidden="true"
      >
        <div class="h-full rounded-t-lg overflow-hidden border border-slate-300 shadow-2xl bg-white flex flex-col">
          <!-- modern chrome -->
          <div class="bg-slate-100 border-b border-slate-200 px-3 py-2 shrink-0">
            <div class="flex items-center gap-2">
              <div class="flex gap-1.5 shrink-0" aria-hidden="true">
                <span class="w-3 h-3 rounded-full bg-red-400"></span>
                <span class="w-3 h-3 rounded-full bg-amber-400"></span>
                <span class="w-3 h-3 rounded-full bg-green-400"></span>
              </div>
              <div class="flex-1 flex items-center gap-2 bg-white border border-slate-200 rounded-full px-3 py-1 min-w-0">
                <span class="text-brand-600 text-[11px]" aria-hidden="true">🔒</span>
                <span class="text-[11px] text-slate-600 truncate font-mono">www.aspensig.asia</span>
              </div>
            </div>
            <!-- loading bar that sweeps as the "page" paints -->
            <div class="relative h-0.5 -mb-2 mt-2 overflow-hidden">
              <div data-loadbar class="absolute inset-y-0 left-0 w-0 bg-brand-500"></div>
            </div>
          </div>

          <!-- a compact rendition of the current homepage -->
          <div class="flex-1 overflow-hidden bg-gradient-to-br from-brand-50 via-white to-brand-100/40">
            <div class="px-5 sm:px-8 py-4 flex items-center justify-between border-b border-slate-200/70 bg-white/70">
              <div data-paint="1" class="flex items-center gap-2">
                <img src={`${base}/images/AsPenLogo.png`} alt="" class="w-7 h-7 object-contain" aria-hidden="true" />
                <span class="font-bold text-slate-900 text-sm">AsPEN</span>
              </div>
              <div data-paint="2" class="hidden sm:flex gap-1 text-[11px] text-slate-600">
                {["About", "Databases", "Activities", "Publications"].map((l) => (
                  <span class="px-2 py-1 rounded hover:bg-slate-100">{l}</span>
                ))}
              </div>
            </div>

            <div class="px-5 sm:px-10 py-8 sm:py-10">
              <p data-paint="3" class="uppercase tracking-widest text-[10px] text-brand-600 font-semibold">
                Asian Pharmacoepidemiology Network
              </p>
              <h3 data-paint="4" class="mt-2 text-2xl sm:text-4xl font-bold text-slate-900 leading-tight">
                Multi-national studies for <span class="text-brand-600">Asia</span>
              </h3>
              <div data-paint="5" class="mt-6 grid grid-cols-3 gap-3 max-w-md">
                {[
                  { n: "5", l: "Countries" },
                  { n: "11", l: "Databases" },
                  { n: "279M", l: "Population" },
                ].map((s) => (
                  <div class="bg-white/80 border border-slate-200 rounded-lg px-3 py-2">
                    <p class="text-lg sm:text-xl font-bold text-brand-700 tabular-nums">{s.n}</p>
                    <p class="text-[10px] uppercase tracking-wide text-slate-500">{s.l}</p>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- flash at the moment of handover -->
      <div data-flash class="pointer-events-none absolute inset-0 bg-white opacity-0 rounded-t-lg"></div>
    </div>

    <!-- controls -->
    <div class="mt-6 flex flex-wrap items-center gap-3">
      <button
        type="button"
        data-open-new
        class="inline-flex items-center gap-2 bg-brand-700 hover:bg-brand-800 text-white font-semibold rounded-lg px-5 py-2.5 text-sm shadow-sm transition"
      >
        Open the new AsPEN
        <span aria-hidden="true">→</span>
      </button>
      <button
        type="button"
        data-replay
        class="hidden items-center gap-2 text-brand-700 hover:text-brand-800 font-semibold text-sm hover:underline"
      >
        <span aria-hidden="true">↺</span> Show the old site again
      </button>
      <a
        href={SNAPSHOT_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs text-slate-500 hover:text-brand-700 hover:underline ml-auto"
      >
        View the {SNAPSHOT_DATE} snapshot on the Internet Archive ↗
      </a>
    </div>
  </section>

  <!-- ================= Timeline ================= -->
  <section class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 pb-20">
    <h2 class="text-xs uppercase tracking-widest text-brand-600 font-semibold mb-8">Milestones</h2>

    <ol data-timeline class="relative border-l-2 border-brand-100 ml-3 sm:ml-6 space-y-10">
      {milestones.map((m) => (
        <li data-milestone class="relative pl-6 sm:pl-8">
          <span
            class="absolute -left-[9px] top-1.5 w-4 h-4 rounded-full bg-brand-500 ring-4 ring-white"
            aria-hidden="true"
          ></span>
          <p class="text-xs font-bold text-brand-600 tabular-nums tracking-widest">{m.year}</p>
          <h3 class="mt-1 text-lg font-bold text-slate-900">{m.title}</h3>
          <p class="mt-1.5 text-sm text-slate-600 leading-relaxed max-w-2xl">{m.body}</p>
        </li>
      ))}
    </ol>

    <p class="mt-12 text-xs text-slate-500 italic max-w-3xl">
      The previous site is reconstructed from the Internet Archive's capture of {SNAPSHOT_DATE};
      the masthead, background, and photograph are the originals from that snapshot.
    </p>
  </section>

  <style>
    /* --- old window handover --- */
    [data-old-window] {
      transition:
        transform 900ms cubic-bezier(.7, 0, .84, 0),
        opacity 700ms ease-in 200ms,
        filter 700ms ease-in;
    }
    [data-old-window].is-leaving {
      transform: perspective(1800px) rotateX(14deg) scale(.86) translateY(-24px);
      opacity: 0;
      filter: grayscale(1) brightness(1.3) blur(2px);
    }
    [data-scanlines].is-glitching {
      opacity: 1;
      animation: glitch-shake 420ms steps(2) 2;
    }
    [data-sweep] {
      top: -20%;
    }
    [data-scanlines].is-glitching [data-sweep] {
      animation: sweep-down 620ms ease-in 1;
    }
    @keyframes sweep-down {
      from { top: -20%; }
      to   { top: 110%; }
    }
    @keyframes glitch-shake {
      0%   { transform: translateX(0); }
      25%  { transform: translateX(-4px); }
      50%  { transform: translateX(5px); }
      75%  { transform: translateX(-2px); }
      100% { transform: translateX(0); }
    }

    /* --- flash --- */
    [data-flash].is-flashing { animation: flash 520ms ease-out 1; }
    @keyframes flash {
      0%   { opacity: 0; }
      18%  { opacity: .95; }
      100% { opacity: 0; }
    }

    /* --- new window arrival --- */
    [data-new-window] {
      transform: scale(.9) translateY(34px);
      transition:
        opacity 420ms ease-out,
        transform 780ms cubic-bezier(.16, 1.02, .3, 1);
    }
    [data-new-window].is-open {
      opacity: 1;
      transform: scale(1) translateY(0);
      pointer-events: auto;
    }
    [data-loadbar] { transition: width 900ms cubic-bezier(.25, 1, .3, 1); }
    [data-loadbar].is-loaded { width: 100%; }

    /* content paints in, block by block, like a page rendering */
    [data-paint] {
      opacity: 0;
      transform: translateY(14px);
      transition: opacity 420ms ease-out, transform 520ms cubic-bezier(.16, 1, .3, 1);
    }
    [data-new-window].is-painted [data-paint] { opacity: 1; transform: none; }
    [data-new-window].is-painted [data-paint="1"] { transition-delay: 120ms; }
    [data-new-window].is-painted [data-paint="2"] { transition-delay: 200ms; }
    [data-new-window].is-painted [data-paint="3"] { transition-delay: 300ms; }
    [data-new-window].is-painted [data-paint="4"] { transition-delay: 400ms; }
    [data-new-window].is-painted [data-paint="5"] { transition-delay: 520ms; }

    /* --- timeline reveal ---
       Only hide the items once JS has confirmed it can reveal them again
       (the .js-reveal hook is set by the script). Without this, a script error
       or an IntersectionObserver that never fires would leave real content
       permanently invisible. */
    [data-timeline].js-reveal [data-milestone] {
      opacity: 0;
      transform: translateY(18px);
    }
    [data-milestone] {
      transition: opacity 500ms ease-out, transform 600ms cubic-bezier(.16, 1, .3, 1);
    }
    [data-timeline].js-reveal [data-milestone].is-in { opacity: 1; transform: none; }

    /* Anyone who asks for less motion gets the content, none of the theatre. */
    @media (prefers-reduced-motion: reduce) {
      [data-old-window],
      [data-new-window],
      [data-paint],
      [data-milestone],
      [data-loadbar] {
        transition: none !important;
        animation: none !important;
      }
      [data-paint], [data-milestone] { opacity: 1; transform: none; }
      [data-scanlines], [data-flash] { display: none; }
    }
  </style>

  <script>
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const stage    = document.querySelector("[data-stage]");
    const oldWin   = document.querySelector("[data-old-window]");
    const newWin   = document.querySelector("[data-new-window]");
    const scan     = document.querySelector("[data-scanlines]");
    const flash    = document.querySelector("[data-flash]");
    const loadbar  = document.querySelector("[data-loadbar]");
    const openBtn  = document.querySelector("[data-open-new]");
    const replay   = document.querySelector("[data-replay]");

    if (stage && oldWin && newWin && openBtn && replay) {
      const timers: number[] = [];
      const after = (ms: number, fn: () => void) => {
        timers.push(window.setTimeout(fn, reduced ? 0 : ms));
      };
      const clearTimers = () => {
        timers.forEach(clearTimeout);
        timers.length = 0;
      };

      // The old window is the one that defines the stage height; once it leaves
      // it is taken out of flow, so pin the height first to stop a jump.
      const pinHeight = () => {
        (stage as HTMLElement).style.height = oldWin.getBoundingClientRect().height + "px";
      };

      let isOpen = false;

      const openNew = () => {
        if (isOpen) return;
        isOpen = true;
        clearTimers();
        pinHeight();

        openBtn.setAttribute("disabled", "");
        openBtn.classList.add("opacity-60", "cursor-not-allowed");

        // 1. the old page glitches
        scan?.classList.add("is-glitching");

        // 2. it folds away, and the screen flashes as the new one takes over
        after(360, () => {
          oldWin.classList.add("is-leaving");
          flash?.classList.add("is-flashing");
        });

        // 3. the new window arrives, chrome first
        after(620, () => {
          scan?.classList.remove("is-glitching");
          newWin.classList.add("is-open");
          newWin.removeAttribute("aria-hidden");
          loadbar?.classList.add("is-loaded");
        });

        // 4. then the page paints in, block by block
        after(880, () => newWin.classList.add("is-painted"));

        after(1500, () => {
          flash?.classList.remove("is-flashing");
          replay.classList.remove("hidden");
          replay.classList.add("inline-flex");
        });
      };

      const showOld = () => {
        if (!isOpen) return;
        isOpen = false;
        clearTimers();

        newWin.classList.remove("is-open", "is-painted");
        newWin.setAttribute("aria-hidden", "true");
        loadbar?.classList.remove("is-loaded");
        oldWin.classList.remove("is-leaving");

        replay.classList.add("hidden");
        replay.classList.remove("inline-flex");
        openBtn.removeAttribute("disabled");
        openBtn.classList.remove("opacity-60", "cursor-not-allowed");

        after(700, () => { (stage as HTMLElement).style.height = ""; });
      };

      openBtn.addEventListener("click", openNew);
      replay.addEventListener("click", showOld);

      // Play it once on its own when the stage is properly in view; someone who
      // scrolls straight past shouldn't have to hunt for the button.
      if (!reduced && "IntersectionObserver" in window) {
        // Threshold 0 plus a position test, not a visible-fraction threshold:
        // the stage is taller than a short laptop viewport, and a ratio-based
        // threshold could then never be met, leaving the reveal unplayed.
        const auto = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              if (e.boundingClientRect.top > window.innerHeight * 0.6) continue;
              auto.disconnect();
              // Long enough that the old cover registers as a real page
              // before it gives way.
              after(1800, openNew);
            }
          },
          { threshold: 0 },
        );
        auto.observe(stage);
      }

      window.addEventListener("resize", () => { if (isOpen) pinHeight(); });
    }

    // Timeline items rise as they come into view. Opt in to hiding them only
    // when we can definitely reveal them again.
    const timeline = document.querySelector("[data-timeline]");
    if (timeline && !reduced && "IntersectionObserver" in window) {
      timeline.classList.add("js-reveal");
      const items = timeline.querySelectorAll("[data-milestone]");
      let observerRan = false;
      const io = new IntersectionObserver(
        (entries) => {
          observerRan = true; // fires even for non-intersecting targets
          entries.forEach((e, i) => {
            if (!e.isIntersecting) return;
            const el = e.target as HTMLElement;
            el.style.transitionDelay = i * 70 + "ms";
            el.classList.add("is-in");
            io.unobserve(el);
          });
        },
        { threshold: 0.25, rootMargin: "0px 0px -40px 0px" },
      );
      items.forEach((el) => io.observe(el));

      // An IntersectionObserver always delivers an initial callback for the
      // elements it observes. If none arrived, observation isn't working here,
      // so drop the animation rather than leave the milestones invisible.
      window.setTimeout(() => {
        if (!observerRan) {
          io.disconnect();
          timeline.classList.remove("js-reveal");
        }
      }, 1200);
    }
  </script>
</BaseLayout>
