---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import publications from "../data/publications.json";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Milestone years are read back from publications.json by PMID so this page
// can't drift from the Publications page.
const pmidYear = (pmid: string): number | null =>
  (publications as { pmid?: string; year?: number }[]).find((p) => p.pmid === pmid)?.year ?? null;

const milestones: { year: string; title: string; body: string }[] = [
  {
    year: "2012",
    title: "AsPEN is founded",
    body: "Established in April 2012 as a Special Interest Group of the International Society for Pharmacoepidemiology (ISPE), to support multi-national database research across the Asia-Pacific.",
  },
  {
    year: String(pmidYear("23653370") ?? 2013),
    title: "The founding paper",
    body: "The network and its approach to rapid, multi-country adverse drug event assessment are described in print, alongside the first Prescription Sequence Symmetry Analysis (PSSA) studies.",
  },
  {
    year: String(pmidYear("26133022") ?? 2015),
    title: "Mapping the region's databases",
    body: "A survey of population-level databases across the Asia-Pacific becomes the reference for what data exist, where, and on what terms; it still anchors the Databases page today.",
  },
  {
    year: String(pmidYear("30100761") ?? 2018),
    title: "A common data model",
    body: "Harmonising site-level data structures lets a single protocol run locally at each site and the estimates be pooled centrally.",
  },
  {
    year: String(pmidYear("38146486") ?? 2023),
    title: "NeuroGEN",
    body: "The data infrastructure extends beyond Asia, spanning partner databases across Oceania, Europe, and North America.",
  },
  {
    year: "2026",
    title: "A new home",
    body: "The WordPress site is retired for a static, open-source rebuild: an interactive database catalogue, themed publications, and a members' area.",
  },
];

const SNAPSHOT_DATE = "7 December 2019";
const SNAPSHOT_URL = "https://web.archive.org/web/20191207010519/https://www.aspensig.asia/";
---

<BaseLayout
  title="History · AsPEN"
  description="AsPEN from its founding in 2012 to today."
>
  <PageHeader
    eyebrow="2012 to today"
    title="History"
    description="AsPEN has been running longer than most of the databases it studies. Here is where it started."
  />

  <!-- ================= The mark =================
       Rests on the current identity. The former masthead is behind it, and
       only comes forward for someone who knows how to ask. -->
  <section class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-14">
    <h2 class="text-xs uppercase tracking-widest text-brand-600 font-semibold mb-3">The mark</h2>
    <p class="text-slate-600 max-w-2xl leading-relaxed mb-8">
      The identity AsPEN carries today.
    </p>

    <div
      data-swap
      class="relative rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden [perspective:1600px]"
    >
      <div data-card class="relative [transform-style:preserve-3d]">
        <!-- FRONT: what the site uses now -->
        <div data-face-new class="px-6 sm:px-10 py-10 sm:py-14 flex items-center justify-center [backface-visibility:hidden]">
          <div class="flex items-center gap-4 sm:gap-6">
            <img
              src={`${base}/images/AsPenLogo.png`}
              alt="AsPEN"
              class="w-16 h-16 sm:w-24 sm:h-24 object-contain shrink-0"
            />
            <div>
              <p class="text-lg sm:text-3xl font-bold text-brand-700 leading-tight tracking-tight">
                Asian Pharmacoepidemiology Network
              </p>
              <p class="mt-1 text-xs sm:text-sm text-slate-500">Beyond a SIG of ISPE</p>
            </div>
          </div>
        </div>

        <!-- BACK: the masthead it carried for over a decade -->
        <div
          data-face-old
          class="absolute inset-0 px-6 sm:px-10 py-10 sm:py-14 flex items-center justify-center [backface-visibility:hidden]"
        >
          <img
            src={`${base}/images/history/old-masthead.png`}
            alt=""
            aria-hidden="true"
            class="w-full max-w-2xl"
          />
        </div>
      </div>

      <!-- the flash across the swap -->
      <div data-flash class="pointer-events-none absolute inset-0 bg-white opacity-0"></div>
      <!-- a band of light sweeping over the mark -->
      <div
        data-shine
        class="pointer-events-none absolute inset-y-0 -left-1/3 w-1/3 opacity-0 bg-gradient-to-r from-transparent via-white to-transparent skew-x-12"
      ></div>
    </div>

    <!-- Announced only to assistive tech, so the swap isn't silent for it. -->
    <p data-swap-status class="sr-only" aria-live="polite"></p>
  </section>

  <!-- ================= The old site ================= -->
  <section class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 pb-14">
    <h2 class="text-xs uppercase tracking-widest text-brand-600 font-semibold mb-3">The old site</h2>
    <p class="text-slate-600 max-w-2xl leading-relaxed mb-6">
      The WordPress site that carried AsPEN until the rebuild, reconstructed from the Internet
      Archive's capture of {SNAPSHOT_DATE}, down to the tiled background and the certificate
      warning it always showed.
    </p>

    <div class="rounded-t-lg overflow-hidden border border-slate-300 shadow-xl">
      <div class="bg-gradient-to-b from-slate-200 to-slate-300 border-b border-slate-400/60 px-3 py-2">
        <div class="flex items-center gap-2">
          <div class="flex gap-1.5 shrink-0" aria-hidden="true">
            <span class="w-3 h-3 rounded-full bg-red-400 border border-red-500/40"></span>
            <span class="w-3 h-3 rounded-full bg-amber-400 border border-amber-500/40"></span>
            <span class="w-3 h-3 rounded-full bg-green-400 border border-green-500/40"></span>
          </div>
          <div class="flex-1 flex items-center gap-2 bg-white/90 border border-slate-400/50 rounded px-2 py-1 min-w-0">
            <span class="text-[10px] font-bold text-red-600 whitespace-nowrap flex items-center gap-1">
              <span aria-hidden="true">⚠</span> Not secure
            </span>
            <span class="text-[11px] text-slate-600 truncate font-mono">www.aspensig.asia</span>
          </div>
        </div>
      </div>

      <div
        style={`background-color:#f4f4f4; background-image:url('${base}/images/history/old-bg-tile.png'); background-repeat:repeat;`}
      >
        <div class="bg-white/85 px-4 sm:px-8 pt-6 pb-0">
          <img
            src={`${base}/images/history/old-masthead.png`}
            alt=""
            aria-hidden="true"
            class="w-full max-w-3xl mx-auto"
          />
        </div>

        <div class="bg-[#5a5a5a] text-white text-[11px] sm:text-xs">
          <div class="max-w-4xl mx-auto flex flex-wrap items-center justify-center gap-x-6 gap-y-1 px-4 py-2.5 font-semibold tracking-wide">
            <span>About US</span>
            <span>National Groups and Contact Persons</span>
            <span>Activities</span>
            <span>Publications</span>
            <span>Related Links</span>
          </div>
        </div>

        <div class="max-w-4xl mx-auto px-4 sm:px-8 py-6">
          <img
            src={`${base}/images/history/old-banner.jpg`}
            alt="AsPEN members at an ICPE poster session"
            class="w-full rounded-sm border border-slate-300"
          />
          <p class="mt-2 text-center text-[11px] text-slate-500 italic">AsPen Photo</p>

          <h3 class="mt-6 text-lg font-bold text-slate-800" style="font-family:Georgia,serif;">About AsPEN</h3>
          <p class="mt-1 text-sm font-bold text-slate-700" style="font-family:Georgia,serif;">What is AsPEN?</p>
          <p class="mt-2 text-[13px] text-slate-600 leading-relaxed" style="font-family:Georgia,serif;">
            The Asian Pharmacoepidemiology Network, or AsPEN, is a multi-national research
            network which was formed to provide a mechanism to support the conduct of
            pharmaco-epidemiological research and to facilitate the prompt identification
            and validation of emerging safety issues among the Asian countries.
          </p>
          <p class="mt-4 text-[13px] text-slate-500" style="font-family:Georgia,serif;">1. The History of AsPEN</p>
        </div>
      </div>
    </div>

    <p class="mt-3 text-xs text-slate-500">
      <a href={SNAPSHOT_URL} target="_blank" rel="noopener noreferrer" class="hover:text-brand-700 hover:underline">
        View the {SNAPSHOT_DATE} snapshot on the Internet Archive ↗
      </a>
    </p>
  </section>

  <!-- ================= Timeline ================= -->
  <section class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 pb-20">
    <h2 class="text-xs uppercase tracking-widest text-brand-600 font-semibold mb-8">Milestones</h2>

    <ol data-timeline class="relative border-l-2 border-brand-100 ml-3 sm:ml-6 space-y-10">
      {milestones.map((m) => (
        <li data-milestone class="relative pl-6 sm:pl-8">
          <span class="absolute -left-[9px] top-1.5 w-4 h-4 rounded-full bg-brand-500 ring-4 ring-white" aria-hidden="true"></span>
          <p class="text-xs font-bold text-brand-600 tabular-nums tracking-widest">{m.year}</p>
          <h3 class="mt-1 text-lg font-bold text-slate-900">{m.title}</h3>
          <p class="mt-1.5 text-sm text-slate-600 leading-relaxed max-w-2xl">{m.body}</p>
        </li>
      ))}
    </ol>
  </section>

  <style>
    /* ---------- the mark ---------- */
    [data-card] {
      transform-style: preserve-3d;
      transition: transform 900ms cubic-bezier(.66, 0, .2, 1);
    }
    /* The back face is pre-rotated so it reads the right way round once flipped. */
    [data-face-old] { transform: rotateY(180deg); }
    [data-swap].is-old [data-card] { transform: rotateY(180deg); }

    [data-flash].is-flashing { animation: flash 700ms ease-out 1; }
    @keyframes flash {
      0%   { opacity: 0; }
      12%  { opacity: .92; }
      100% { opacity: 0; }
    }

    [data-shine].is-shining { animation: shine 900ms ease-in-out 1; }
    @keyframes shine {
      0%   { opacity: 0;  left: -33%; }
      15%  { opacity: .9; }
      85%  { opacity: .9; }
      100% { opacity: 0;  left: 110%; }
    }

    [data-swap].is-jolt { animation: jolt 380ms steps(2) 1; }
    @keyframes jolt {
      0%   { transform: translateX(0); }
      30%  { transform: translateX(-3px); }
      60%  { transform: translateX(4px); }
      100% { transform: translateX(0); }
    }

    /* ---------- timeline ----------
       Hidden only once the script confirms it can reveal them again, so a
       script error or a browser that never reports intersection cannot leave
       real content permanently invisible. */
    [data-timeline].js-reveal [data-milestone] { opacity: 0; transform: translateY(18px); }
    [data-milestone] { transition: opacity 500ms ease-out, transform 600ms cubic-bezier(.16, 1, .3, 1); }
    [data-timeline].js-reveal [data-milestone].is-in { opacity: 1; transform: none; }

    @media (prefers-reduced-motion: reduce) {
      [data-card], [data-milestone] { transition: none !important; }
      [data-swap], [data-flash], [data-shine] { animation: none !important; }
    }
  </style>

  <script>
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // ---- The mark rests on the current identity; typing the founding year
    // ---- brings the old masthead round, and typing it again puts it back.
    const CODE = "2012";
    const swap   = document.querySelector("[data-swap]");
    const flash  = document.querySelector("[data-flash]");
    const shine  = document.querySelector("[data-shine]");
    const status = document.querySelector("[data-swap-status]");

    if (swap) {
      let buffer = "";
      let busy = false;

      const play = () => {
        if (busy) return;
        busy = true;

        swap.classList.add("is-jolt");
        flash?.classList.add("is-flashing");
        shine?.classList.add("is-shining");

        // Turn the card at the peak of the flash, so the change is covered.
        window.setTimeout(() => {
          swap.classList.toggle("is-old");
          if (status) {
            status.textContent = swap.classList.contains("is-old")
              ? "Showing the former AsPEN masthead."
              : "Showing the current AsPEN identity.";
          }
        }, reduced ? 0 : 210);

        window.setTimeout(() => {
          swap.classList.remove("is-jolt");
          flash?.classList.remove("is-flashing");
          shine?.classList.remove("is-shining");
          busy = false;
        }, reduced ? 0 : 1000);
      };

      window.addEventListener("keydown", (e) => {
        if (e.metaKey || e.ctrlKey || e.altKey) return;
        const t = e.target as HTMLElement | null;
        if (t && /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName)) return;
        if (t && t.isContentEditable) return;
        if (e.key.length !== 1) return;

        buffer = (buffer + e.key).slice(-CODE.length);
        if (buffer === CODE) {
          buffer = "";
          play();
        }
      });
    }

    // ---- timeline reveal ----
    const timeline = document.querySelector("[data-timeline]");
    if (timeline && !reduced && "IntersectionObserver" in window) {
      timeline.classList.add("js-reveal");
      const items = timeline.querySelectorAll("[data-milestone]");
      let observerRan = false;
      const io = new IntersectionObserver(
        (entries) => {
          observerRan = true;
          entries.forEach((e, i) => {
            if (!e.isIntersecting) return;
            const el = e.target as HTMLElement;
            el.style.transitionDelay = i * 70 + "ms";
            el.classList.add("is-in");
            io.unobserve(el);
          });
        },
        { threshold: 0.25, rootMargin: "0px 0px -40px 0px" },
      );
      items.forEach((el) => io.observe(el));

      // An observer always delivers an initial callback; if none arrived,
      // observation is not working here, so drop the animation entirely.
      window.setTimeout(() => {
        if (!observerRan) { io.disconnect(); timeline.classList.remove("js-reveal"); }
      }, 1200);
    }
  </script>
</BaseLayout>
