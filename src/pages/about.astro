---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import Section from "../components/Section.astro";
import ChairCard from "../components/ChairCard.astro";
import GovernanceChart from "../components/GovernanceChart.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout title="About AsPEN" description="Mission, goals and objectives, governance, how to join, and leadership of the Asian Pharmacoepidemiology Network.">
  <PageHeader
    eyebrow="About"
    title="About AsPEN"
    description="A multi-national research network supporting pharmacoepidemiologic studies and prompt safety-signal validation across Asia."
  />

  <nav aria-label="Section" class="border-b border-slate-200 bg-white sticky top-16 z-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 flex flex-wrap gap-1 py-2 text-sm">
      <a href="#mission" class="px-3 py-1.5 rounded hover:bg-slate-100 text-slate-700">Mission</a>
      <a href="#goals" class="px-3 py-1.5 rounded hover:bg-slate-100 text-slate-700">Goals & Objectives</a>
      <a href="#governance" class="px-3 py-1.5 rounded hover:bg-slate-100 text-slate-700">Governance</a>
      <a href="#how-to-join" class="px-3 py-1.5 rounded hover:bg-slate-100 text-slate-700">How to join</a>
      <a href="#leadership" class="px-3 py-1.5 rounded hover:bg-slate-100 text-slate-700">Leadership</a>
    </div>
  </nav>

  <Section id="mission" eyebrow="01" title="Mission">
    <p>To study the effectiveness and safety of medications from Asian countries, and to facilitate prompt identification and validation of emerging safety issues across the region. To advance multi-national database research in pharmacoepidemiology in the Asia/Pacific region through education, capacity building, equitable collaboration, and knowledge exchange among researchers and colleagues.</p>
  </Section>

  <Section id="goals" eyebrow="02" title="Goals and Objectives">
    <div class="not-prose space-y-8">
      {[
        {
          n: 1,
          heading: "To advance high-quality, multi-national pharmacoepidemiologic research across the Asia-Pacific region",
          items: [
            "Conduct collaborative studies on medication utilization, effectiveness, and safety using databases from Asian countries and regions",
            "Support timely signal detection, signal validation, and evidence generation for emerging medication safety issues",
            "Promote transparent, reproducible, and fit-for-purpose research approaches across diverse healthcare systems and data environments",
            "Strengthen methodological capacity for cross-database studies, including distributed analyses, common data models, and multi-country study governance",
          ],
        },
        {
          n: 2,
          heading: "To strengthen education, training, and capacity building in pharmacoepidemiology",
          items: [
            "Host symposia, workshops, webinars, and training activities for researchers, students, policymakers, and healthcare practitioners",
            "Provide opportunities for students, early-career researchers, and colleagues from emerging research settings to engage in formal or hands-on training",
            "Promote knowledge exchange on study design, data analytics, regulatory science, real-world evidence, and cross-national database research",
            "Support mentorship and career development within the Asia-Pacific pharmacoepidemiology community",
          ],
        },
        {
          n: 3,
          heading: "To foster equitable, sustainable, and open collaboration across countries, regions, and research groups",
          items: [
            "Facilitate regular communication and collaboration among AsPEN members through online meetings, in-person meetings, and collaborative scientific activities",
            "Encourage equitable participation and leadership across countries, disciplines, career stages, and data settings",
            "Promote AsPEN's mission and scientific contributions through publications, presentations, workshops, and international partnerships",
            "Support flexible connections and working groups that enable members to collaborate based on shared interests and regional priorities",
          ],
        },
        {
          n: 4,
          heading: "To enhance regional and international impact through evidence generation, policy engagement, and scientific exchange",
          items: [
            "Translate pharmacoepidemiologic evidence into insights relevant to clinical practice, regulatory decision-making, and public health policy",
            "Engage with international societies, regulatory stakeholders, and research networks to amplify Asia-Pacific perspectives",
            "Identify region-specific medication safety and effectiveness questions that may not be adequately addressed in other populations or single-country studies",
            "Contribute to global real-world evidence development by highlighting the diversity of Asian healthcare systems, populations, and data sources",
          ],
        },
      ].map((g) => (
        <article class="grid grid-cols-[auto_1fr] gap-4 sm:gap-6">
          <div class="shrink-0">
            <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-full bg-brand-50 border border-brand-200 text-brand-700 flex flex-col items-center justify-center leading-none">
              <span class="text-[9px] uppercase tracking-widest font-semibold">Goal</span>
              <span class="text-lg sm:text-xl font-bold tabular-nums">{g.n}</span>
            </div>
          </div>
          <div>
            <h3 class="text-base sm:text-lg font-semibold text-slate-900 leading-snug">{g.heading}</h3>
            <ul class="mt-3 space-y-1.5 text-sm text-slate-700 leading-relaxed list-disc pl-5 marker:text-brand-500">
              {g.items.map((it) => <li>{it}</li>)}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </Section>

  <Section id="governance" eyebrow="03" title="Governance">
    <p>AsPEN is a <strong>Special Interest Group (SIG)</strong> of the International Society for Pharmacoepidemiology (ISPE), established in April 2012. AsPEN has evolved into an international research network, supporting collaborative initiatives such as NeuroGEN, vaccine safety studies, and pregnancy pharmacoepidemiology research. Leadership rotates among national groups through a Chair-Elect, Chair, and Immediate Past Chair cycle. The Chair holds strategy, governance, operations, and ISPE liaison, and two functional offices carry the work: Academic & Education, and Communications & Engagement. The Immediate Past Chair serves one leadership cycle in an advisory role, providing continuity and institutional memory without operational duties.</p>
    <GovernanceChart />
  </Section>

  <Section id="how-to-join" eyebrow="04" title="How to join">
    <p>AsPEN membership is open to researchers, healthcare professionals, regulators, and graduate students with an interest in pharmacoepidemiology in Asia/Pacific who are current members of ISPE and are recommended by a current AsPEN member. Both are requirements, not options.</p>

    <div class="not-prose mt-6">
      <a
        href={`${base}/membership/`}
        class="group block border-2 border-brand-500 rounded-2xl p-6 bg-gradient-to-br from-brand-50 to-white hover:shadow-md hover:border-brand-700 transition max-w-2xl"
      >
        <p class="text-xs uppercase tracking-widest text-brand-700 font-bold">Recommended</p>
        <h3 class="mt-2 text-xl font-bold text-slate-900 group-hover:text-brand-700 transition">Become an AsPEN member</h3>
        <p class="mt-2 text-sm text-slate-700 leading-relaxed">Apply directly to the AsPEN Chair and the Academic &amp; Education office. Self-signup, vetted before approval.</p>
        <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-700">
          Apply <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
        </span>
      </a>
    </div>

    <p class="mt-6 text-sm text-slate-600">For general inquiries or to discuss local data access and collaboration, see the <a href={`${base}/contact/`}>Contact</a> page.</p>
  </Section>

  <Section id="leadership" eyebrow="05" title="Leadership">
    <div class="not-prose grid gap-8 md:grid-cols-[auto_1fr] items-start">
      <div class="shrink-0 mx-auto md:mx-0">
        <div class="relative">
          <div class="absolute -inset-2 bg-gradient-to-br from-accent-500/15 to-brand-500/15 rounded-2xl blur-lg"></div>
          <img
            src={`${base}/images/Daniel.jpeg`}
            alt="Daniel Tsai"
            class="relative w-52 h-64 object-cover object-top rounded-2xl shadow-md border border-slate-200"
          />
        </div>
      </div>
      <div>
        <p class="text-xs uppercase tracking-widest text-brand-600 font-semibold">Current Chair</p>
        <h3 class="mt-1 text-3xl font-bold text-slate-900">Daniel Tsai</h3>
        <p class="mt-1 text-slate-600">National Cheng Kung University (NCKU)</p>
        <p class="mt-5 text-slate-700 leading-relaxed">
          Daniel Tsai is a postdoctoral research fellow at the <a href="https://www.phdcenter.org.tw/" target="_blank" rel="noopener" class="text-brand-700 hover:underline">Population Health Data Center</a>, NCKU. He specializes in comparative effectiveness research and policy research. His expertise includes triangulating claims databases, electronic health records, and biomedical databases to inform causal inference, and operationalizing infrastructure to support real-world evidence generation. He is involved in the intersection of artificial intelligence and geriatric medicine. Daniel serves as a member of the Neurological and Mental Health Global Epidemiology Network (NeuroGEN), where he contributes to international research collaboration and the advancement of pharmacoepidemiology.
        </p>
        <div class="mt-4 flex flex-wrap gap-2">
          <a href="https://orcid.org/0000-0003-2841-0338" target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-white border border-slate-300 text-xs font-medium text-slate-700 hover:border-[#A6CE39] hover:text-slate-900 transition" aria-label="Daniel Tsai ORCID profile">
            <svg width="14" height="14" viewBox="0 0 256 256" aria-hidden="true"><circle cx="128" cy="128" r="128" fill="#A6CE39"/><text x="128" y="170" text-anchor="middle" font-family="Arial,sans-serif" font-size="124" font-weight="900" fill="#fff">iD</text></svg>
            <span class="tabular-nums">0000-0003-2841-0338</span>
          </a>
          <a href="https://www.researchgate.net/profile/Daniel-Tsai-8" target="_blank" rel="noopener" class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-white border border-slate-300 text-xs font-medium text-slate-700 hover:border-brand-400 hover:text-brand-700 transition">
            Profile <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>

    <hr class="not-prose my-10 border-slate-200" />

    <div class="not-prose grid gap-8 md:grid-cols-[auto_1fr] items-start">
      <div class="shrink-0 mx-auto md:mx-0">
        <div class="relative">
          <div class="absolute -inset-2 bg-gradient-to-br from-accent-500/15 to-brand-500/15 rounded-2xl blur-lg"></div>
          <div class="relative w-52 h-64 rounded-2xl shadow-md border border-slate-200 bg-brand-50 grid place-items-center text-brand-700 font-bold text-5xl" aria-hidden="true">SN</div>
        </div>
      </div>
      <div>
        <p class="text-xs uppercase tracking-widest text-brand-600 font-semibold">Chair-Elect</p>
        <h3 class="mt-1 text-3xl font-bold text-slate-900">Shiori Nishimura</h3>
        <p class="mt-1 text-slate-600">Yokohama City University, Graduate School of Data Science</p>
        <p class="mt-5 text-slate-700 leading-relaxed">
          Dr Shiori Nishimura is a Project Assistant Professor at the Graduate School of Data Science, Yokohama City University, Japan. She trained in health policy and management at Keio University, where she earned her PhD in pharmacoepidemiology, and worked in the Department of Healthcare Quality Assessment at the University of Tokyo before joining Yokohama City University in 2025. Her research uses Japanese claims and registry data to study medication use and safety in cardiovascular medicine, including frailty and clinical outcomes in older adults with atrial fibrillation and heart failure, and the comparative safety of targeted therapies in rheumatology.
        </p>
        <div class="mt-4 flex flex-wrap gap-2">
          <a href="https://orcid.org/0000-0003-1319-3158" target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-white border border-slate-300 text-xs font-medium text-slate-700 hover:border-[#A6CE39] hover:text-slate-900 transition" aria-label="Shiori Nishimura ORCID profile">
            <svg width="14" height="14" viewBox="0 0 256 256" aria-hidden="true"><circle cx="128" cy="128" r="128" fill="#A6CE39"/><text x="128" y="170" text-anchor="middle" font-family="Arial,sans-serif" font-size="124" font-weight="900" fill="#fff">iD</text></svg>
            <span class="tabular-nums">0000-0003-1319-3158</span>
          </a>
        </div>
      </div>
    </div>

    <hr class="not-prose my-10 border-slate-200" />

    <div class="not-prose grid gap-8 md:grid-cols-[auto_1fr] items-start">
      <div class="shrink-0 mx-auto md:mx-0">
        <div class="relative">
          <div class="absolute -inset-2 bg-gradient-to-br from-accent-500/15 to-brand-500/15 rounded-2xl blur-lg"></div>
          <img
            src={`${base}/images/Judy.jpg`}
            alt="Ju-Young Shin"
            class="relative w-52 h-64 object-cover object-top rounded-2xl shadow-md border border-slate-200"
          />
        </div>
      </div>
      <div>
        <p class="text-xs uppercase tracking-widest text-brand-600 font-semibold">Immediate Past Chair</p>
        <h3 class="mt-1 text-3xl font-bold text-slate-900">Ju-Young Shin</h3>
        <p class="mt-1 text-slate-600">Seoul National University (SNU) · Sungkyunkwan University (SKKU)</p>
        <p class="mt-1 text-sm text-slate-500 italic">Continuity and advisory role, for one leadership cycle.</p>
        <p class="mt-5 text-slate-700 leading-relaxed">
          Dr Ju-Young Shin is a professor at the College of Pharmacy, Seoul National University, South Korea. She serves as an associate editor for <em>Pharmacoepidemiology and Drug Safety</em>, <em>Vaccines</em>, and <em>Epidemiology and Health</em>. Dr Shin holds a PhD in pharmacoepidemiology from Seoul National University and has extensive experience as a director at the Korea Institute of Drug Safety Management. She has published over 150 peer-reviewed articles in journals including <em>BMJ</em>, <em>Gut</em>, and <em>Allergy</em>, with research interests spanning vaccine safety, biologics, and real-world evidence. She also advises the Korean Ministry of Food and Drug Safety and serves on committees for the Korean Society for Pharmacoepidemiology, contributing important regulatory and scientific expertise. She served as Chair of AsPEN from 2024 to 2026.
        </p>
        <div class="mt-4 flex flex-wrap gap-2">
          <a href="https://orcid.org/0000-0003-1010-7525" target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-white border border-slate-300 text-xs font-medium text-slate-700 hover:border-[#A6CE39] hover:text-slate-900 transition" aria-label="Ju-Young Shin ORCID profile">
            <svg width="14" height="14" viewBox="0 0 256 256" aria-hidden="true"><circle cx="128" cy="128" r="128" fill="#A6CE39"/><text x="128" y="170" text-anchor="middle" font-family="Arial,sans-serif" font-size="124" font-weight="900" fill="#fff">iD</text></svg>
            <span class="tabular-nums">0000-0003-1010-7525</span>
          </a>
          <a href="https://snupharm.snu.ac.kr/en/snu__professor/judy-juyoung-shin/" target="_blank" rel="noopener" class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-white border border-slate-300 text-xs font-medium text-slate-700 hover:border-brand-400 hover:text-brand-700 transition">
            Profile <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>

    <hr class="not-prose my-10 border-slate-200" />

    <div class="not-prose grid gap-8 md:grid-cols-[auto_1fr] items-start">
      <div class="shrink-0 mx-auto md:mx-0">
        <div class="relative">
          <div class="absolute -inset-2 bg-gradient-to-br from-accent-500/15 to-brand-500/15 rounded-2xl blur-lg"></div>
          <img
            src={`${base}/images/Edward.jpeg`}
            alt="Edward Lai"
            class="relative w-52 h-64 object-cover object-top rounded-2xl shadow-md border border-slate-200"
          />
        </div>
      </div>
      <div>
        <p class="text-xs uppercase tracking-widest text-brand-600 font-semibold">Education Lead</p>
        <h3 class="mt-1 text-3xl font-bold text-slate-900">Edward Lai</h3>
        <p class="mt-1 text-slate-600">National Cheng Kung University (NCKU) · Founder, <a href="https://www.phdcenter.org.tw/" target="_blank" rel="noopener" class="text-brand-700 hover:underline">PHDc</a></p>
        <p class="mt-5 text-slate-700 leading-relaxed">
          Edward is a Professor at the School of Pharmacy, National Cheng Kung University (NCKU), Taiwan. He is also the leader of the Institutional Research Division, R&amp;D Office at NCKU. He has expertise in the use of a variety of healthcare databases across Asia, Oceania, North America, and Europe in the conduct of international multi-database pharmacoepidemiologic research. His research interests include the safety and effectiveness of medications, as well as the methods for real-world evidence (RWE) studies. He has published 140+ research articles in top journals such as <em>BMJ</em>, <em>Nature Medicine</em>, <em>JAMA Internal Medicine</em>, and <em>Annals of Internal Medicine</em>. He has served as an Associate Editor of <em>Pharmacoepidemiology and Drug Safety</em> since 2013. He served as the chair of the Asian Pharmacoepidemiology Network (AsPEN) (2016-2018) and the Educational leader since 2024. He is an active member of the Neurological and Mental Health Global Epidemiology Network (NeuroGEN). He was awarded the Fellow of the International Society for Pharmacoepidemiology (FISPE) designation in 2023 and the Outstanding Research Award of the National Science and Technology Council of Taiwan.
        </p>
        <div class="mt-4 flex flex-wrap gap-2">
          <a href="https://orcid.org/0000-0002-5852-7652" target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-white border border-slate-300 text-xs font-medium text-slate-700 hover:border-[#A6CE39] hover:text-slate-900 transition" aria-label="Edward Lai ORCID profile">
            <svg width="14" height="14" viewBox="0 0 256 256" aria-hidden="true"><circle cx="128" cy="128" r="128" fill="#A6CE39"/><text x="128" y="170" text-anchor="middle" font-family="Arial,sans-serif" font-size="124" font-weight="900" fill="#fff">iD</text></svg>
            <span class="tabular-nums">0000-0002-5852-7652</span>
          </a>
          <a href="https://researchoutput.ncku.edu.tw/en/persons/edward-lai/" target="_blank" rel="noopener" class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-white border border-slate-300 text-xs font-medium text-slate-700 hover:border-brand-400 hover:text-brand-700 transition">
            Profile <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>

  </Section>

</BaseLayout>
