  <style>
    .mono { font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }

    /* faint console grid, drifting slowly */
    .vx-grid {
      background-image:
        linear-gradient(to right, rgba(22, 40, 63, 0.55) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(22, 40, 63, 0.55) 1px, transparent 1px);
      background-size: 44px 44px;
      animation: vx-drift 40s linear infinite;
    }
    @keyframes vx-drift { to { background-position: 44px 44px; } }

    /* radar sweep */
    .vx-sweep {
      background: conic-gradient(from 0deg, rgba(34, 211, 238, 0.28), rgba(34, 211, 238, 0) 70deg, transparent 360deg);
      animation: vx-spin 6s linear infinite;
    }
    @keyframes vx-spin { to { transform: rotate(360deg); } }

    /* blips breathe, staggered by inline animation-delay */
    .vx-blip { animation: vx-breathe 2.6s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
    @keyframes vx-breathe { 0%, 100% { opacity: .35; } 50% { opacity: 1; } }

    /* data flowing along the converging lines */
    .vx-flow { stroke-dasharray: 4 7; animation: vx-dash 1.6s linear infinite; }
    @keyframes vx-dash { to { stroke-dashoffset: -22; } }

    @media (prefers-reduced-motion: reduce) {
      .vx-grid, .vx-sweep, .vx-blip, .vx-flow { animation: none !important; }
      .vx-blip { opacity: .8; }
    }
  </style>
