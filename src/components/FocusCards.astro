---
// Two teaser cards for the Infrastructure theme page, each a miniature of
// the focus-area page it opens: a dark console for vaccine safety, a
// chalkboard for NeuroGEN. Counts are computed from the same data the pages
// use, so a card can never disagree with the page behind it.
import databasesRaw from "../data/databases.json";
import { DATABASES as VACCINE_DBS } from "../data/vaccine-suitability";

interface Props {
  areas: ("neurogen" | "vaccine")[];
}
const { areas } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

type Db = (typeof databasesRaw)[number] & { neurogen?: boolean; mapAs?: string };
const ng = (databasesRaw as Db[]).filter((d) => d.neurogen);
const ngRegions = new Set(ng.map((d) => d.mapAs ?? d.country)).size;
const vxRegions = new Set(VACCINE_DBS.map((d) => d.region)).size;
---

<section aria-labelledby="focus-heading" class="mb-10">
  <h2 id="focus-heading" class="text-xs uppercase tracking-widest text-brand-600 font-semibold mb-3">Focus areas</h2>
  <div class="grid gap-5 md:grid-cols-2">
    {areas.map((area) => (
      <Fragment>
    {area === "vaccine" && (
      <a href={`${base}/focus/vaccine/`} class="fc-vx group relative block overflow-hidden rounded-xl p-6 text-[#e2e8f0] transition hover:-translate-y-0.5 hover:shadow-xl">
        <span class="absolute -top-16 -right-16 w-56 h-56 rounded-full bg-[radial-gradient(closest-side,rgba(34,211,238,0.18),transparent)]" aria-hidden="true"></span>
        <p class="fc-mono relative text-[10px] tracking-[0.22em] text-[#67e8f9]">DISEASE X <span class="text-[#2a3f5c]">//</span> CASE FILE 001</p>
        <h3 class="relative mt-3 text-2xl font-bold text-white">Vaccine safety</h3>
        <p class="relative mt-2 text-sm leading-relaxed text-[#b6c2d3]">
          When the next pandemic vaccine rolls out, which Asia-Pacific data can watch its safety from day one?
        </p>
        <p class="fc-mono relative mt-5 flex flex-wrap gap-x-5 gap-y-1 text-[11px] tracking-wider text-[#8193ab]">
          <span><span class="fc-dot inline-block w-1.5 h-1.5 rounded-full bg-[#22d3ee] align-middle mr-1.5" aria-hidden="true"></span>{vxRegions} REGIONS</span>
          <span>{VACCINE_DBS.length} DATABASES</span>
        </p>
        <span class="fc-mono relative mt-5 inline-flex items-center gap-1 text-xs font-bold tracking-wider text-[#67e8f9]">
          ENTER THE CONSOLE <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
        </span>
      </a>
    )}

    {area === "neurogen" && (
      <a href={`${base}/focus/neurogen/`} class="fc-ng group relative block overflow-hidden rounded-xl p-[10px] transition hover:-translate-y-0.5 hover:shadow-xl">
        <div class="fc-board relative h-full rounded-md p-5 text-[#f1f0e8]">
          <!-- a tiny chalk graph -->
          <svg class="absolute right-4 top-4 w-[120px] h-[88px] opacity-80" viewBox="0 0 120 88" aria-hidden="true">
            <g stroke="#f1f0e8" stroke-width="1.3" stroke-linecap="round" fill="none" opacity=".75">
              <line x1="60" y1="46" x2="16" y2="30" /><line x1="60" y1="46" x2="34" y2="10" /><line x1="60" y1="46" x2="72" y2="8" />
              <line x1="60" y1="46" x2="106" y2="24" /><line x1="60" y1="46" x2="108" y2="62" /><line x1="60" y1="46" x2="84" y2="82" />
              <line x1="60" y1="46" x2="12" y2="66" />
            </g>
            <g fill="#f1f0e8"><circle cx="16" cy="30" r="2.6" /><circle cx="34" cy="10" r="2.6" /><circle cx="72" cy="8" r="2.6" /><circle cx="106" cy="24" r="2.6" /><circle cx="108" cy="62" r="2.6" /><circle cx="84" cy="82" r="2.6" /><circle cx="12" cy="66" r="2.6" /></g>
            <circle cx="60" cy="46" r="10" stroke="#f4e285" stroke-width="1.6" fill="#223128" />
          </svg>
          <p class="fc-hand relative text-4xl leading-none">NeuroGEN</p>
          <p class="fc-hand relative mt-1 text-xl text-[#d9d6c8] max-w-[70%] leading-tight">Neurological &amp; Mental Disorders</p>
          <p class="fc-hand relative mt-4 text-2xl">
            {ng.length} databases · {ngRegions} regions · <span class="text-[#f4e285]">≈ 320M people</span>
          </p>
          <span class="relative mt-4 inline-flex items-center gap-1 text-xs font-semibold tracking-wide text-[#f4e285]">
            Open the board <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
          </span>
        </div>
      </a>
    )}
      </Fragment>
    ))}
  </div>
</section>

<style>
  .fc-mono { font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
  .fc-hand { font-family: "Caveat", "Segoe Print", "Bradley Hand", cursive; }

  .fc-vx {
    background-color: #060d18;
    background-image:
      linear-gradient(to right, rgba(22, 40, 63, 0.6) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(22, 40, 63, 0.6) 1px, transparent 1px);
    background-size: 28px 28px;
    border: 1px solid #16283f;
  }
  .fc-ng { background: linear-gradient(180deg, #6b4a2f, #4a3220); }
  .fc-board {
    background-color: #223128;
    background-image: radial-gradient(ellipse at 30% 30%, rgba(241, 240, 232, 0.06), transparent 60%);
    box-shadow: inset 0 0 40px rgba(0, 0, 0, 0.45);
  }

  @keyframes fc-breathe { 0%, 100% { opacity: .35; } 50% { opacity: 1; } }
  .fc-dot { animation: fc-breathe 2.4s ease-in-out infinite; }
  @media (prefers-reduced-motion: reduce) { .fc-dot { animation: none; } }
</style>
