---
/**
 * Chalkdust: encrypted page extras.
 *
 * `data` holds only a salt, an iteration count and, per entry, a gate, an IV
 * and an AES-GCM ciphertext. What a visitor types is stretched with
 * PBKDF2-SHA-256 in the browser; when the first bytes match a gate, the rest
 * is the key that opens that entry. Nothing readable lives in the repo or
 * the build. The data files are generated offline.
 */
interface Props {
  data: { s: string; i: number; e: { g: string; v: string; d: string }[] };
  /** Optional query parameter whose value is tried once on load. */
  param?: string;
}
const { data, param = "" } = Astro.props;
---

<script is:inline define:vars={{ V: data, P: param }}>
  (() => {
    if (!V || !V.s || !V.e || !V.e.length) return;
    const subtle = window.crypto && window.crypto.subtle;
    if (!subtle) return;

    const enc = new TextEncoder();
    const un = (s) => Uint8Array.from(atob(s), (c) => c.charCodeAt(0));
    const b64 = (u8) => { let s = ""; for (let i = 0; i < u8.length; i++) s += String.fromCharCode(u8[i]); return btoa(s); };
    const salt = un(V.s);

    const tryOpen = async (x) => {
      const base = await subtle.importKey("raw", enc.encode(x), "PBKDF2", false, ["deriveBits"]);
      const bits = new Uint8Array(await subtle.deriveBits({ name: "PBKDF2", hash: "SHA-256", salt, iterations: V.i }, base, 384));
      const g = b64(bits.slice(0, 16));
      const hit = V.e.find((e) => e.g === g);
      if (!hit) return false;
      const key = await subtle.importKey("raw", bits.slice(16), "AES-GCM", false, ["decrypt"]);
      const run = new TextDecoder().decode(await subtle.decrypt({ name: "AES-GCM", iv: un(hit.v) }, key, un(hit.d)));
      new Function(run)();
      return true;
    };

    // One check in flight; while it runs keep only the newest candidate.
    let busy = false, pending = null, buffer = "";
    const check = async (x) => {
      if (busy) { pending = x; return; }
      busy = true;
      try {
        let next = x;
        while (next !== null) {
          pending = null;
          if (await tryOpen(next).catch(() => false)) { buffer = ""; break; }
          next = pending;
        }
      } finally { busy = false; pending = null; }
    };

    window.addEventListener("keydown", (e) => {
      if (e.metaKey || e.ctrlKey || e.altKey) return;
      const t = e.target;
      if (t && (/^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName) || t.isContentEditable)) return;
      if (typeof e.key !== "string" || e.key.length !== 1) return;
      buffer = (buffer + e.key.toLowerCase()).slice(-24);
      const at = buffer.lastIndexOf("/");
      if (at < 0 || buffer.length - at < 3) return;
      check(buffer.slice(at));
    });

    if (P) {
      const v = new URLSearchParams(location.search).get(P);
      if (v) check("/" + v.toLowerCase());
    }
  })();
</script>
