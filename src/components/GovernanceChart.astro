---
// AsPEN Governance; org chart
// Tier 1: Chair (top, centered)
// Tier 1: Chair
// Tier 2: Academic & Education Office | Communications & Engagement Office
// Tier 3: an office's lead, under it
// The Chair-Elect and Immediate Past Chair are introduced in the About page's Leadership section only.
import LeaderCard from "./LeaderCard.astro";
import type { Leader } from "./LeaderCard.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const chair: Leader = {
  name: "Daniel Tsai",
  role: "Chair",
  inst: "NCKU",
  photo: "Daniel.jpeg",
  orcid: "0000-0003-2841-0338",
  profile: "https://www.researchgate.net/profile/Daniel-Tsai-8",
};

const educationLead: Leader = {
  name: "Edward Lai",
  role: "Education Lead",
  inst: "NCKU",
  photo: "Edward.jpeg",
  // Edward.jpeg is 1365×1923 (portrait); object-cover crops top/bottom in the
  // 80×80 round frame. "center 10%" keeps his head inside it.
  pos: "center 10%",
  orcid: "0000-0002-5852-7652",
  profile: "https://researchoutput.ncku.edu.tw/en/persons/edward-lai/",
};

// The two functional offices under the Chair. An office may name its lead.
const offices: { title: string; text: string; bar: string; lead?: Leader }[] = [
  {
    title: "Academic & Education Office",
    text: "Scientific programmes, workshops, education, and research initiatives; mentoring early-career researchers across AsPEN member sites.",
    bar: "from-accent-500 to-brand-500",
    lead: educationLead,
  },
  {
    title: "Communications & Engagement Office",
    text: "External communications, public relations, membership, and outreach.",
    bar: "from-brand-500 to-brand-700",
  },
];

const initials = (n: string) => n.split(" ").map((p) => p[0]).slice(0, 2).join("");
---

<div class="not-prose my-8">
  <!-- ── TIER 1 · CHAIR ──────────────────────────────────────── -->
  <p class="text-[10px] uppercase tracking-[0.25em] text-brand-600 font-bold mb-3 text-center">Chair</p>
  <article class="relative overflow-hidden rounded-2xl bg-white border border-slate-200 shadow-sm max-w-xl mx-auto">
    <div class="absolute left-0 top-0 bottom-0 w-1.5 bg-gradient-to-b from-accent-500 via-brand-500 to-brand-700"></div>
    <div class="flex flex-col sm:flex-row items-center gap-4 sm:gap-5 p-4 pl-6">
      <div class="shrink-0 w-24 h-24 rounded-xl overflow-hidden bg-brand-50 border border-slate-200">
        {chair.photo ? (
          <img src={`${base}/images/${chair.photo}`} alt={chair.name} class="block w-full h-full object-cover object-top" />
        ) : (
          <div class="w-full h-full grid place-items-center text-brand-700 font-bold text-3xl">{initials(chair.name)}</div>
        )}
      </div>
      <div class="flex-1 flex flex-col justify-center text-center sm:text-left">
        <p class="text-xl font-bold text-slate-900 leading-tight">{chair.name}</p>
        <p class="text-sm text-slate-600 mt-0.5">{chair.inst}</p>
        <p class="text-sm text-slate-600 mt-2 leading-relaxed">
          Strategy, governance, operations, and ISPE liaison.
        </p>
        {(chair.orcid || chair.profile) && (
          <div class="mt-3 flex flex-wrap gap-2 justify-center sm:justify-start">
            {chair.orcid && (
              <a href={`https://orcid.org/${chair.orcid}`} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-white border border-slate-300 text-xs font-medium text-slate-700 hover:border-[#A6CE39] hover:text-slate-900 transition" aria-label={`${chair.name} ORCID profile`}>
                <svg width="14" height="14" viewBox="0 0 256 256" aria-hidden="true"><circle cx="128" cy="128" r="128" fill="#A6CE39"/><text x="128" y="170" text-anchor="middle" font-family="Arial,sans-serif" font-size="124" font-weight="900" fill="#fff">iD</text></svg>
                <span class="tabular-nums">{chair.orcid}</span>
              </a>
            )}
            {chair.profile && (
              <a href={chair.profile} target="_blank" rel="noopener" class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-white border border-slate-300 text-xs font-medium text-slate-700 hover:border-brand-400 hover:text-brand-700 transition">
                Profile <span aria-hidden="true">↗</span>
              </a>
            )}
          </div>
        )}
      </div>
    </div>
  </article>

  <!-- vertical drop from the chair to the offices -->
  <div class="flex justify-center"><div class="w-px h-8 bg-slate-300"></div></div>

  <!-- ── TIER 2 · two offices; TIER 3 · an office's lead under it ── -->
  <div class="relative max-w-4xl mx-auto">
    <!-- horizontal connector across the two offices (desktop only) -->
    <div class="hidden md:block absolute top-0 left-1/4 right-1/4 h-px bg-slate-300"></div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {offices.map((b) => (
        <div class="flex flex-col items-center">
          <div class="hidden md:block w-px h-8 bg-slate-300"></div>
          <div class="md:hidden w-px h-5 bg-slate-300"></div>
          <article class="relative overflow-hidden rounded-2xl bg-white border border-slate-200 shadow-sm w-full md:min-h-[9rem]">
            <div class={`absolute left-0 top-0 bottom-0 w-1.5 bg-gradient-to-b ${b.bar}`}></div>
            <div class="p-5 pl-7">
              <p class="text-[10px] uppercase tracking-[0.25em] text-brand-700 font-bold">{b.title}</p>
              <p class="text-sm text-slate-700 mt-3 leading-relaxed">{b.text}</p>
            </div>
          </article>
          {b.lead && (
            <>
              <div class="w-px h-8 bg-slate-300"></div>
              <div class="w-full"><LeaderCard m={b.lead} /></div>
            </>
          )}
        </div>
      ))}
    </div>
  </div>
</div>
