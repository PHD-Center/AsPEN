---
// The world laid down as a floor beneath the hero: a dot map of the land,
// tilted back into perspective, with the AsPEN sites marked on it. Purely
// decorative, so it is hidden from assistive tech and ignores the pointer.
//
// The dot map is generated from Natural Earth land (world-atlas land-110m),
// sampled on a grid and centred on 150E so the Asia-Pacific sits mid-plane
// with the Americas to the right. Marker coordinates come from the same
// projection, so they land exactly on their own dots.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const VB_W = 1000;
const VB_H = 338.9;

const SITES = [
  { name: "Taiwan",         x: 419.4, y: 139.7 },
  { name: "Japan",          x: 471.2, y: 106.4 },
  { name: "South Korea",    x: 438.3, y: 104.2 },
  { name: "Hong Kong",      x: 400.5, y: 143.6 },
  { name: "Thailand",       x: 362.5, y: 167.3 },
  { name: "Australia",      x: 454.9, y: 275.8 },
  { name: "United Kingdom", x:  83.0, y:  62.5 },
  { name: "Netherlands",    x:  97.6, y:  60.9 },
  { name: "Finland",        x: 152.6, y:  38.4 },
  { name: "United States",  x: 869.3, y:  97.5 },
];
---

<div data-floor class="pointer-events-none absolute inset-x-0 bottom-0 h-[68%] overflow-hidden" aria-hidden="true">
  <div data-floor-plane class="absolute inset-x-[-30%] bottom-0 h-full">
    <div class="relative w-full h-full text-brand-700/35">
      <img
        src={`${base}/images/world-dots.svg`}
        alt=""
        class="absolute inset-x-0 bottom-0 w-full"
        style="opacity:.4;"
      />

      <!-- AsPEN sites, sitting on their own dots -->
      <svg
        class="absolute inset-x-0 bottom-0 w-full overflow-visible"
        viewBox={`0 0 ${VB_W} ${VB_H}`}
        fill="none"
      >
        {SITES.map((s, i) => (
          <g data-site style={`--d:${(i * 0.42).toFixed(2)}s`}>
            <circle cx={s.x} cy={s.y} r="2.6" class="fill-brand-600" />
            <circle cx={s.x} cy={s.y} r="2.6" class="fill-none stroke-brand-500" stroke-width="1.1" data-ping />
          </g>
        ))}
      </svg>
    </div>
  </div>
</div>

<style>
  /* The plane lies down and runs away from the reader. Anchored at its near
     edge so the far edge is what recedes. */
  [data-floor] {
    perspective: 1200px;
    perspective-origin: 50% 100%;
    /* Dissolve into the page at the horizon and at both sides, so the floor
       never shows a hard rectangular edge. */
    -webkit-mask-image:
      linear-gradient(to top, #000 12%, rgba(0,0,0,.65) 45%, transparent 88%),
      linear-gradient(to right, transparent, #000 18%, #000 82%, transparent);
    mask-image:
      linear-gradient(to top, #000 12%, rgba(0,0,0,.65) 45%, transparent 88%),
      linear-gradient(to right, transparent, #000 18%, #000 82%, transparent);
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
  }
  [data-floor-plane] {
    transform: rotateX(42deg) translateZ(0);
    transform-origin: 50% 100%;
  }

  /* Each site breathes out a ring, staggered so they don't pulse in unison. */
  @keyframes site-ping {
    0%      { r: 2.6; opacity: .85; }
    70%,
    100%    { r: 13;  opacity: 0; }
  }
  [data-ping] {
    animation: site-ping 3.6s ease-out infinite;
    animation-delay: var(--d, 0s);
    transform-box: fill-box;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-ping] { animation: none; opacity: 0; }
  }
</style>
