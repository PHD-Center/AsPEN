    };

    // until the map is ready, hold any theme asked for
    if (!window.__dress) window.__dress = (n) => (window.__dressQ = window.__dressQ || []).push(n);

    // place names per dress: [name, lat, lng, kind]; kind is cap, city (default), land or sea
    const LABELS = {"britain":[["London",51.507,-0.128,"cap"],["Edinburgh",55.953,-3.189],["Dublin",53.35,-6.26],["York",53.96,-1.08],["Bristol",51.45,-2.59],["Oxford",51.75,-1.26],["Cambridge",52.205,0.12],["Manchester",53.48,-2.24],["Belfast",54.6,-5.93],["Plymouth",50.375,-4.14],["Norwich",52.63,1.3],["England",52.6,-1.55,"land"],["Wales",52.3,-3.75,"land"],["Scotland",56.9,-4.2,"land"],["Ireland",53.2,-8.1,"land"],["The German Ocean",55.2,3.2,"sea"],["The Irish Sea",53.9,-5.1,"sea"],["The British Channel",50.1,-2.2,"sea"]],"scotland":[["Edinburgh",55.953,-3.189,"cap"],["Glasgow",55.864,-4.252],["Aberdeen",57.15,-2.09],["Dundee",56.46,-2.97],["Inverness",57.48,-4.22],["Perth",56.4,-3.43],["St Andrews",56.34,-2.8],["Stirling",56.12,-3.94],["Fort William",56.82,-5.11],["Oban",56.41,-5.47],["Wick",58.44,-3.09],["Highlands",57.25,-4.7,"land"],["Hebrides",57.6,-7.2,"land"],["Southern Uplands",55.4,-3.6,"land"],["North Sea",57.2,-0.9,"sea"],["The Minch",58.1,-5.9,"sea"],["Firth of Forth",56.1,-2.65,"sea"]],"netherlands":[["Amsterdam",52.37,4.9,"cap"],["Rotterdam",51.92,4.48],["'s-Gravenhage",52.08,4.3],["Utrecht",52.09,5.12],["Leiden",52.16,4.49],["Haarlem",52.38,4.64],["Groningen",53.22,6.57],["Middelburg",51.5,3.61],["Nijmegen",51.84,5.86],["Maastricht",50.85,5.69],["Leeuwarden",53.2,5.8],["Frisia",53.05,6,"land"],["Zeelandia",51.55,3.85,"land"],["Brabantia",51.55,5.25,"land"],["Mare Germanicum",52.9,3.3,"sea"],["Zuiderzee",52.72,5.42,"sea"]],"finland":[["Helsinki",60.17,24.94,"cap"],["Turku",60.45,22.27],["Tampere",61.5,23.76],["Oulu",65.01,25.47],["Vaasa",63.1,21.62],["Kuopio",62.89,27.68],["Jyväskylä",62.24,25.75],["Rovaniemi",66.5,25.73],["Joensuu",62.6,29.76],["Lappeenranta",61.06,28.19],["Lappi",67.6,26.6,"land"],["Karjala",62.3,30.4,"land"],["Pohjanlahti",63.2,20.4,"sea"],["Suomenlahti",59.75,25.8,"sea"]],"japan":[["東京",35.68,139.69,"cap"],["京都",35.01,135.77],["大阪",34.69,135.5],["名古屋",35.18,136.91],["仙台",38.27,140.87],["札幌",43.06,141.35],["福岡",33.59,130.4],["広島",34.39,132.46],["金沢",36.56,136.66],["長崎",32.75,129.87],["鹿児島",31.6,130.56],["新潟",37.92,139.04],["日本海",39.6,134.4,"sea"],["太平洋",32.4,141.6,"sea"],["瀬戸内海",34.12,133.2,"sea"]],"korea":[["서울",37.566,126.978,"cap"],["부산",35.18,129.08],["대구",35.87,128.6],["인천",37.46,126.7],["광주",35.16,126.85],["대전",36.35,127.38],["울산",35.54,129.31],["전주",35.82,127.15],["경주",35.86,129.22],["춘천",37.88,127.73],["강릉",37.75,128.9],["제주",33.5,126.53],["동해",37.2,130.4,"sea"],["황해",36.1,125.1,"sea"],["남해",34.25,127.9,"sea"]],"taiwan":[["臺北",25.03,121.56,"cap"],["基隆",25.13,121.74],["新竹",24.8,120.97],["臺中",24.15,120.67],["嘉義",23.48,120.45],["臺南",22.99,120.21],["高雄",22.63,120.3],["恆春",22,120.74],["宜蘭",24.75,121.75],["花蓮",23.98,121.6],["臺東",22.76,121.14],["澎湖",23.57,119.58],["中央山脈",23.55,121.05,"land"],["臺灣海峽",24.1,119.75,"sea"],["太平洋",23.2,122.25,"sea"],["巴士海峽",21.55,120.95,"sea"]],"hongkong":[["Cheung Chau<b class=\"z\">長洲</b>",22.21,114.028,"cap"],["Victoria<b class=\"z\">維多利亞城</b>",22.282,114.158],["Kowloon<b class=\"z\">九龍</b>",22.318,114.18],["Peng Chau<b class=\"z\">坪洲</b>",22.287,114.04],["Silver Mine Bay<b class=\"z\">銀礦灣</b>",22.268,114],["Tai O<b class=\"z\">大澳</b>",22.254,113.862],["Aberdeen<b class=\"z\">香港仔</b>",22.248,114.155],["Lantao Island",22.25,113.93,"land"],["Lamma Island",22.205,114.125,"land"],["Hong Kong Island",22.262,114.2,"land"],["West Lamma Channel",22.19,114.07,"sea"],["Adamasta Channel",22.165,113.99,"sea"],["South China Sea",22.08,114.1,"sea"]],"thailand":[["Bangkok<b class=\"z\">กรุงเทพฯ</b>",13.756,100.502,"cap"],["Ayutthaya",14.35,100.57],["Chiang Mai",18.79,98.98],["Sukhothai",17,99.82],["Nakhon Ratchasima",14.97,102.1],["Khon Kaen",16.44,102.83],["Udon Thani",17.41,102.79],["Hat Yai",7,100.47],["Phuket",7.88,98.39],["Surat Thani",9.14,99.33],["Chiang Rai",19.91,99.83],["Siam",15.6,101,"land"],["Gulf of Siam",10.6,101.4,"sea"],["Andaman Sea",9.6,96.8,"sea"]],"australia":[["Canberra",-35.28,149.13,"cap"],["Sydney",-33.87,151.21],["Melbourne",-37.81,144.96],["Bris