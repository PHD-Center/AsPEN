        day: (y) => { const d = new Date(y, 3, 27); return d.getDay() === 0 ? new Date(y, 3, 26) : d; },
        fonts: "Cormorant+Garamond:ital,wght@1,700",
        // a small Delft flower between two rules
        vars: band(48, 16, "#f0e2c0", `<path d='M0 .5H48M0 15.5H48' stroke='#1d4f91'/><g transform='translate(24 8)' fill='#1d4f91'>` +
          [0, 90, 180, 270].map((a) => `<ellipse cy='-2.9' rx='1.25' ry='2.3' transform='rotate(${a})'/>`).join("") +
          [45, 135, 225, 315].map((a) => `<circle cy='-3.7' r='.6' transform='rotate(${a})'/>`).join("") + `</g>`),
        cart: (c) => `<div class="t">Fijne Koningsdag!</div><div style="font-size:12px">King's Day · ${THEMES.netherlands.day(new Date().getFullYear()).getDate()} April · ${n(c)}</div><span class="ribbon">ORANJE BOVEN</span>`,
        deco: () => compass(fleur("#1d4f91"), "#1d4f91", "#1d4f91", "#f0e2c0"),
      },
      finland: {
        group: "FI", zoom: 5, day: on(11, 6), tiles: "World_Shaded_Relief", native: 13,
        fonts: "Cormorant+Garamond:wght@700",
        // engraved rules with a small lozenge now and then
        vars: band(72, 12, "#eef0ec", `<path d='M0 .5H72M0 11.5H72' stroke='#3d5570'/><path d='M36 3L39 6L36 9L33 6Z' fill='#3d5570'/>`),
        cart: (c) => `<div class="k">Independence Day · 6 December</div><div class="t">Hyvää itsenäisyyspäivää!</div><div class="k">${n(c)} in Finland</div>`,
        deco: () => `<svg class="mt-candles" viewBox="0 0 48 56" aria-hidden="true" fill="#f4f4f0" stroke="#3d5570" stroke-width="1">
          <rect x="8" y="26" width="10" height="28" rx="1"/><rect x="30" y="26" width="10" height="28" rx="1"/><path d="M13 26V22M35 26V22"/>
          <path class="flame" d="M13 21 C9 16 13 12 13 7 C16 12 17 16 13 21 Z"/><path class="flame b" d="M35 21 C31 16 35 12 35 7 C38 12 39 16 35 21 Z"/></svg>`,
      },
      japan: {
