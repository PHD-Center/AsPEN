<script is:inline define:vars={{ mapId, base }}>
  (() => {
    const el = document.getElementById(mapId);
    if (!el) return;
    const ESRI = "https://services.arcgisonline.com/ArcGIS/rest/services/";
    const ESRI_A = '&copy; <a href="https://www.esri.com/">Esri</a>';
    const SRC = {
      "World_Physical_Map": ESRI_A + ", US National Park Service",
      "World_Shaded_Relief": ESRI_A + ", USGS",
      "Ocean/World_Ocean_Base": ESRI_A + ", GEBCO, NOAA, National Geographic, Garmin, HERE, Geonames.org, and other contributors",
    };
    const still = matchMedia("(prefers-reduced-motion: reduce)").matches;

    // nth weekday of a month: month 0-based, weekday 0 = Sunday
    const nth = (y, m, wd, k) => {
      const first = new Date(y, m, 1).getDay();
      return new Date(y, m, 1 + ((wd - first + 7) % 7) + (k - 1) * 7);
    };
    const on = (m, d) => (y) => new Date(y, m, d);

    // a sixteen-point rose; dark and light halve each point, the cardinals in dark
    const rose = (ink, dark, light) => {
      let pts = "";
      for (let i = 0; i < 16; i++) {
        const a = (i * 22.5 * Math.PI) / 180;
        const r = i % 4 === 0 ? 44 : i % 2 === 0 ? 30 : 20;
        const w = i % 4 === 0 ? 7 : 5;
        const tip = [Math.sin(a) * r, -Math.cos(a) * r];
        const l = [Math.sin(a - Math.PI / 2) * w, -Math.cos(a - Math.PI / 2) * w];
        const rr = [Math.sin(a + Math.PI / 2) * w, -Math.cos(a + Math.PI / 2) * w];
        const f = (p) => p.map((v) => v.toFixed(1)).join(" ");
        pts += `<path d="M0 0 L${f(l)} L${f(tip)} Z" fill="${ink}"/><path d="M0 0 L${f(rr)} L${f(tip)} Z" fill="${i % 4 === 0 ? dark : light}" stroke="${ink}" stroke-width=".5"/>`;
      }
      return `<circle r="36" fill="none" stroke="${ink}" stroke-width=".8"/><circle r="33" fill="none" stroke="${ink}" stroke-width=".4"/>
        ${pts}<circle r="2.5" fill="${light}" stroke="${ink}" stroke-width=".6"/>`;
    };
    const compass = (north, ...c) => `<svg class="mt-compass" viewBox="-50 -58 100 108" aria-hidden="true">${rose(...c)}${north}</svg>`;
    const fleur = (ink) => `<g transform="translate(0 -50) scale(.55)" fill="${ink}"><path d="M0 -12 C4 -7 4 -2 0 3 C-4 -2 -4 -7 0 -12 Z"/>
      <path d="M-1 1 C-5 -6 -12 -4 -10 1 C-9 4 -5 4 -4 1 C-6 2 -8 0 -6 -2 C-4 -3 -2 -1 -1 3 Z"/>
      <path d="M1 1 C5 -6 12 -4 10 1 C9 4 5 4 4 1 C6 2 8 0 6 -2 C4 -3 2 -1 1 3 Z"/><rect x="-5" y="3" width="10" height="2"/><path d="M-2 5 L0 10 L2 5 Z"/></g>`;
    const star = (x, y, r, p = 7, fill = "#fbf6e6", stroke = "none") => {
      let d = "";
      for (let i = 0; i < p * 2; i++) {
        const a = (i * Math.PI) / p - Math.PI / 2;
        const rr = i % 2 ? r * 0.45 : r;
        d += `${i ? "L" : "M"}${(x + Math.cos(a) * rr).toFixed(1)} ${(y + Math.sin(a) * rr).toFixed(1)} `;
      }
      return `<path d="${d}Z" fill="${fill}" stroke="${stroke}" stroke-width=".9" stroke-linejoin="round"/>`;
    };
    const svgUrl = (w, h, body) => `url("data:image/svg+xml,${encodeURIComponent(`<svg xmlns='http://www.w3.org/2000/svg' width='${w}' height='${h}'>${body}</svg>`)}")`;
    // a w×h band tile for the top and bottom bars, turned a quarter for the
    // sides; "stand" is drawn upright on every bar (--bw must equal h)
    const band = (w, h, ground, body, stand = "") => ({
      "--bh": `${svgUrl(w, h, body + stand)} 0 0 / ${w}px ${h}px, ${ground}`,
      "--bv": `${svgUrl(h, w, `<g transform='translate(${h} 0) rotate(90)'>${body}</g><g transform='translate(${(h - w) / 2} ${(w - h) / 2})'>${stand}</g>`)} 0 0 / ${h}px ${w}px, ${ground}`,
    });

    // 包山: a bun tower on its bamboo pole
    const bunshan = (() => {
      let b = "";
      // rows of buns, near-straight sides rounding into a dome
      for (let i = 0; i <= 14; i++) {
        const y = 86 - i * 5.4, half = 15 * Math.sqrt(1 - (i / 14) ** 4);
        const k = Math.round((2 * half) / 5.6) + 1;
        for (let j = 0; j < k; j++) b += `<circle cx="${(k === 1 ? 35 : 35 - half + (j * 2 * half) / (k - 1)).toFixed(1)}" cy="${y.toFixed(1)}" r="2.5"/>`;
      }
      return `<svg class="mt-bunshan" viewBox="0 0 70 100" aria-hidden="true" fill="none" stroke="#3b2f22" stroke-width=".8">
        <path d="M35 95V3M35 3L44 5.5L35 8M17 91H53M20 91V96M50 91V96"/><g fill="#f7f7f2">${b}</g></svg>`;
    })();

    const n = (count) => `${count} AsPEN ${count === 1 ? "database" : "databases"}`;
    const THEMES = {
      britain: {
        group: "GB", zoom: 5, day: (y) => nth(y, 5, 6, 2), tiles: "World_Physical_Map", native: 8,
        fonts: "IM+Fell+English:ital@0;1&family=IM+Fell+English+SC",
        // degree bar: two rules with alternate degrees filled
        vars: band(60, 10, "#efe2bf", `<path d='M0 .5H60M0 9.5H60' stroke='#2b2116'/><rect y='4' width='30' height='2' fill='#2b2116'/>`),
        cart: (c) => `<div class="k">A New Map of the</div><div class="t">Asian Pharmacoepidemiology Network</div>
          <div class="k">Shewing ${n(c)} in the United Kingdom</div><span class="ribbon">On the King's Official Birthday</span>`,
        deco: () => compass(`<text y="-49" text-anchor="middle" font-family="IM Fell English SC, Georgia, serif" font-size="11" fill="#2b2116">N</text>`, "#2b2116", "#225641", "#efe2bf"),
      },
      scotland: {
        group: "gb-sct", zoom: 6, day: on(10, 30), tiles: "World_Shaded_Relief", native: 13,
        fonts: "Cormorant+SC:wght@600",
        // neatline with graduated ticks
        vars: band(50, 13, "#f6f4ee", `<g stroke='#1a1a1a'><path d='M0 .5H50M0 12.5H50'/><path d='M0 6.5H50' stroke-width='.6'/>` +
          [0, 10, 20, 30, 40].map((x) => `<path d='M${x + 0.5} ${x ? 4.5 : 2.5}V${x ? 8.5 : 10.5}'/>`).join("") + `</g>`),
        cart: (c) => `<svg viewBox="0 0 26 30" width="22" height="26" aria-hidden="true"><clipPath id="mt-shield"><path d="M1 1H25V13C25 21 13 29 13 29C13 29 1 21 1 13Z"/></clipPath>
          <g clip-path="url(#mt-shield)"><rect width="26" height="30" fill="#1f3a52"/><path d="M0 0L26 30M26 0L0 30" stroke="#f6f4ee" stroke-width="4"/></g>
          <path d="M1 1H25V13C25 21 13 29 13 29C13 29 1 21 1 13Z" fill="none" stroke="#1a1a1a" stroke-width=".8"/></svg>
          <div class="t">Latha Naomh Anndrais sona dhuibh!</div><div class="k">St Andrew's Day · 30 November · ${n(c)}</div>`,
