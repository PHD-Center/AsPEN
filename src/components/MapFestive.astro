    // each dress carries the real period map it is modelled on, as a plate
    // (public domain, via Wikimedia Commons)
    const PLATES = {"britain":{"t":"The Kingdome of Great Britaine and Ireland","by":"John Speed","y":"1611","src":"https://commons.wikimedia.org/wiki/File:The_Kingdome_of_Great_Britaine_and_Ireland_-_John_Speed_-_Altea_Gallery_17281.jpg"},"scotland":{"t":"Scotia Regnum","by":"Joan Blaeu","y":"1654","src":"https://commons.wikimedia.org/wiki/File:Blaeu_-_Atlas_of_Scotland_1654_-_SCOTIA_REGNUM_-_Kingdom_of_Scotland.jpg"},"netherlands":{"t":"Belgii Foederati nova descriptio","by":"Rijksmuseum RP-P-AO-1-61","y":"1649","src":"https://commons.wikimedia.org/wiki/File:Kaart_van_de_Republiek_der_Zeven_Verenigde_Nederlanden_Belgii_Foederati_nova_descriptio_(titel_op_object),_RP-P-AO-1-61.jpg"},"finland":{"t":"Magni Ducatus Finlandiae … nova et accurata delineatio","by":"Matthäus Seutter","y":"c. 1730","src":"https://commons.wikimedia.org/wiki/File:Magni_Ducatus_Finlandiae_Russiae_partim,_partim_sueciae_subjecti_;_Sinus_item_Bothnici_ac_Finnici_nova_et_accurata_delineatio_Calamo_et_sumtibus_-_btv1b53040647h.jpg"},"japan":{"t":"改正日本輿地路程全圖","by":"長久保赤水 Nagakubo Sekisui","y":"1779","src":"https://commons.wikimedia.org/wiki/File:(Nihon_yochi_rotei_zenzu._LOC_77694708.jpg"},"korea":{"t":"大東輿地圖 Daedongyeojido","by":"金正浩 Kim Jeong-ho","y":"1861","src":"https://commons.wikimedia.org/wiki/File:Daedongyeojido-full.jpg"},"taiwan":{"t":"臺灣前後山全圖","by":"","y":"1880","src":"https://commons.wikimedia.org/wiki/File:臺灣前後山全圖.jpg"},"hongkong":{"t":"Admiralty Chart No. 3026, Macao to Pedro Blanco including Hong Kong","by":"Hydrographic Office","y":"1899","src":"https://commons.wikimedia.org/wiki/File:Admiralty_Chart_No_3026_China_S.E._Coast._Macao_to_Pedro_Blanco_including_Hong_Kong,_Published_1899,_Corrections_to_1929.jpg"},"thailand":{"t":"Carte du royaume de Siam et des pays circonvoisins","by":"P. Placide","y":"1686","src":"https://commons.wikimedia.org/wiki/File:Carte_du_royaume_de_Siam_et_des_pays_circonvoisins_-_par_le_Rd_P._Placide_;_C._Rousset,_sculp._-_btv1b84466960.jpg"},"australia":{"t":"Hollandia Nova detecta 1644","by":"Melchisédech Thévenot","y":"1663","src":"https://commons.wikimedia.org/wiki/File:Thevenot_-_Hollandia_Nova_detecta_1644.png"},"usa":{"t":"Map of the United States and Territories","by":"S. Augustus Mitchell Jr.","y":"1867","src":"https://commons.wikimedia.org/wiki/File:1867_Mitchell_Map_of_the_United_States_-_Geographicus_-_UnitedStates-mitchell-1867.jpg"}};
    const esc = (x) => String(x).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]);
    const plate = (code) => {
      const p = PLATES[code];
      const who = [p.by, p.y].filter(Boolean).join(" · ");
      return `<button type="button" class="mt-plate" aria-label="View the period map: ${esc(p.t)}, ${esc(p.y)}">
        <img src="${base}/images/oldmaps/${code}-s.webp" alt="" /><span>${esc(who)}</span></button>`;
    };
    const enlarge = (code) => {
      const p = PLATES[code];
      const back = document.activeElement;
      const box = document.createElement("div");
      box.className = "mt-light";
      box.setAttribute("role", "dialog");
      box.setAttribute("aria-modal", "true");
      box.setAttribute("aria-label", p.t);
      box.innerHTML = `<figure><img src="${base}/images/oldmaps/${code}.webp" alt="${esc(p.t)}" />
        <figcaption><b>${esc(p.t)}</b>${p.by ? " · " + esc(p.by) : ""} · ${esc(p.y)}
        <a href="${p.src}" target="_blank" rel="noopener">Wikimedia Commons ↗</a> · public domain</figcaption></figure>
        <button type="button" class="mt-light-x" aria-label="Close">×</button>`;
      document.body.appendChild(box);
      const close = () => { box.remove(); document.removeEventListener("keydown", onKey, true); back?.focus?.({ preventScroll: true }); };
      const onKey = (e) => { if (e.key === "Escape") close(); };
      document.addEventListener("keydown", onKey, true);
      box.addEventListener("click", (e) => { if (!e.target.closest("a")) close(); });
      box.querySelector(".mt-light-x").focus({ preventScroll: true });
    };

    const ready = (fn) => (el.__aspen ? fn(el.__aspen) : el.addEventListener("aspen:map", () => fn(el.__aspen), { once: true }));

    ready(({ map, baseLayer, markers, groups }) => {
      const home = { center: map.getCenter(), zoom: map.getZoom() };
      const lp = map.createPane("mtLabels");
      lp.style.zIndex = 550;
      lp.style.pointerEvents = "none";
      map.on("popupopen", () => el.classList.add("mt-popped"));
      map.on("popupclose", () => el.classList.remove("mt-popped"));
      const loaded = new Set();
      let current = null, layers = [], frame = null, vars = [];

      const loadFont = (f) => {
        if (!f || loaded.has(f)) return;
        loaded.add(f);
        const l = document.createElement("link");
        l.rel = "stylesheet";
        l.href = `https://fonts.googleapis.com/css2?family=${f}&display=swap`;
        document.head.appendChild(l);
      };

      const clear = (fly) => {
        if (!current) return;
        el.classList.remove("mt", "mt-" + current);
        vars.forEach((k) => el.style.removeProperty(k));
        vars = [];
        layers.forEach((l) => map.removeLayer(l));
        layers = [];
        if (!map.hasLayer(baseLayer)) baseLayer.addTo(map);
        frame?.remove();
        frame = null;
        markers.forEach((m) => m.getElement()?.classList.remove("mt-hero"));
        current = null;
        if (fly) still ? map.setView(home.center, home.zoom) : map.flyTo(home.center, home.zoom, { duration: 1.2 });
      };

      const lettering = (code) => {
        const list = LABELS[code];
        if (!list) return;
        layers.push(L.layerGroup(list.map(([name, lat, lng, kind = "city"]) => L.marker([lat, lng], {
          pane: "mtLabels", interactive: false, keyboard: false,
          icon: L.divIcon({ className: "mt-lbl " + kind, iconSize: [0, 0],
            html: "<span>" + (kind === "city" || kind === "cap" ? "<i></i>" : "") + name + "</span>" }),
        }))).addTo(map));
        setTimeout(declutter, 60);
        setTimeout(declutter, 900); // again once the lettering's web font is in
      };
      // Names are listed most important first; any that would collide with an
      // earlier one, or sit under a flag, is left out at this zoom.
      const declutter = () => {
        const flags = [...el.querySelectorAll(".aspen-flag-marker img")].map((i) => i.getBoundingClientRect());
        const kept = [...flags];
        const hit = (a, b) => !(a.right + 3 < b.left || a.left - 3 > b.right || a.bottom + 2 < b.top || a.top - 2 > b.bottom);
        el.querySelectorAll(".mt-lbl span").forEach((sp) => {
          sp.style.visibility = "";
          sp.classList.remove("under");
          let r = sp.getBoundingClientRect();
          // a capital under its own flag is lettered just beneath the flag
          if (sp.parentElement.classList.contains("cap") && flags.some((k) => hit(r, k))) {
            sp.classList.add("under");
            r = sp.getBoundingClientRect();
          }
          if (kept.some((k) => hit(r, k))) sp.style.visibility = "hidden";
          else kept.push(r);
        });
      };
      map.on("zoomend moveend", () => { if (current) declutter(); });

      const apply = (code) => {
        const t = THEMES[code];
        clear(false);
        current = code;
        loadFont(t.fonts);
        el.classList.add("mt", "mt-" + code);
        lettering(code);
        // theme values too long or computed for the stylesheet
        Object.entries(t.vars || {}).forEach(([k, v]) => { el.style.setProperty(k, v); vars.push(k); });

        if (t.tiles) {
          map.removeLayer(baseLayer);
          layers.push(L.tileLayer(ESRI + t.tiles + "/MapServer/tile/{z}/{y}/{x}", {
            attribution: SRC[t.tiles] || ESRI_A, maxZoom: 10, maxNativeZoom: t.native, zIndex: 1,
          }).addTo(map));
        }

        const g = groups.findIndex((x) => x.code.toLowerCase() === t.group.toLowerCase());
        const count = g >= 0 ? groups[g].items.length : 0;
        frame = document.createElement("div");
        frame.className = "mt-frame";
        frame.innerHTML = `<div class="mt-paper mt-noise" aria-hidden="true"></div>
          <i class="mt-b mt-bt"></i><i class="mt-b mt-bb"></i><i class="mt-b mt-bl"></i><i class="mt-b mt-br"></i>
          <div class="mt-fx" aria-hidden="true">${t.fx ? t.fx() : ""}</div>
          ${PLATES[code] ? plate(code) : t.deco ? `<div class="mt-deco" aria-hidden="true">${t.deco()}</div>` : ""}
          <div class="mt-cart" role="status">${t.cart(count)}<button type="button" class="mt-x" aria-label="Back to the everyday map">×</button></div>`;
        el.appendChild(frame);
        frame.querySelector(".mt-x").addEventListener("click", () => clear(true));
        const pb = frame.querySelector(".mt-plate");
        if (pb) {
          pb.addEventListener("click", () => enlarge(code));
          L.DomEvent.disableClickPropagation(pb);
          L.DomEvent.disableScrollPropagation(pb);
        }
        L.DomEvent.disableClickPropagation(frame.querySelector(".mt-cart"));
        L.DomEvent.disableScrollPropagation(frame.querySelector(".mt-cart"));

        if (g >= 0) markers[g].getElement()?.classList.add("mt-hero");
        // a theme may look somewhere other than its marker
        const to = t.center || (g >= 0 ? [groups[g].lat, groups[g].lng] : null);
        if (to) still ? map.setView(to, t.zoom) : map.flyTo(to, t.zoom, { duration: 1.4 });
      };

      const toast = (msg) => {
        const old = el.querySelector(".mt-toast");
        old?.remove();
        const d = document.createElement("div");
        d.className = "mt-toast";
        d.textContent = msg;
        el.appendChild(d);
        setTimeout(() => d.remove(), 2200);
      };

      const now = new Date();
      const sameDay = (d) => d.getMonth() === now.getMonth() && d.getDate() === now.getDate();
      const today = Object.keys(THEMES).find((k) => {
        const t = THEMES[k];
        return t.isToday ? t.isToday(now) : sameDay(t.day(now.getFullYear()));
      });
      if (today) apply(today);

      // Other ways in hand over a theme name, or null for the everyday map.
      const dress = (name) => {
        if (name === null) { if (current) { clear(true); toast("Everyday map"); } return; }
        if (!Object.prototype.hasOwnProperty.call(THEMES, name)) return;
        if (current === name) { clear(true); return; }
        el.scrollIntoView({ behavior: still ? "auto" : "smooth", block: "center" });
        apply(name);
      };
      const queued = window.__dressQ || [];
      window.__dress = dress;
      queued.forEach(dress);
    });
  })();
</script>
