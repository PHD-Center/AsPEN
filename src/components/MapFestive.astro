        cart: (c) => `<div class="slip"><div class="t">개천절</div><svg class="taegeuk" viewBox="-20 -20 40 40" aria-hidden="true"><circle r="19" fill="#2b4c8c"/>
          <path d="M-19 0 A19 19 0 0 1 19 0 A9.5 9.5 0 0 0 0 0 A9.5 9.5 0 0 1 -19 0 Z" fill="#b8312f"/></svg></div>
