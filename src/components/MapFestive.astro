          }
          return `<svg width="100%" height="100%"><svg x="72%" y="70%" overflow="visible"><g stroke="#5a4630" stroke-width=".6">${s}</g>
            <g transform="scale(.34)"><circle r="40" fill="#efe2bf"/>${rose("#5a4630", "#1f5c47", "#efe2bf")}</g></svg></svg>`;
