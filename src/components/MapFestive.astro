---
// National-day dress for the light WorldMap (the /databases/ map).
//
// On each member region's national day the map becomes an antique map in
// that country's own cartographic tradition: its basemap and paper, a quiet
// frame band with one fine motif, a cartouche with the day's greeting, at
// most one small period ornament, and the region's marker brought forward.
// The rest of the year the everyday street map is untouched.
//
// Dates are the viewer's local date. Where a region has no statutory
// national day the customary one is used: the King's Official Birthday
// (Trooping the Colour, usually the second Saturday of June) for the UK, St
// Andrew's Day for Scotland, and for Hong Kong the Cheung Chau Bun Festival
// on Buddha's Birthday (the 8th day of the 4th lunar month).
import Chalkdust from "./Chalkdust.astro";
import chalk from "../data/chalk/databases.json";

interface Props {
  mapId: string;
}
const { mapId } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Chalkdust data={chalk} param="map" />

<style is:global>
  /* ── shared frame ─────────────────────────────────────────────── */
  /* each theme sets --ink (rules, text), --card (cartouche paper), --tf (tiles),
     --vig (vignette), --nl (neatline inside the band), and for place names
     --lf (lettering), --lbl (ink) and --halo (paper behind the letters) */
  .mt { --card: #f5ead0; --ink: #2b2116; }
  .mt-frame { position: absolute; inset: 0; z-index: 450; pointer-events: none; }
  .mt-frame > * { position: absolute; }
  .mt-paper {
    inset: 0; mix-blend-mode: multiply;
    background:
      radial-gradient(ellipse at center, transparent 62%, var(--vig, transparent) 100%);
  }
  .mt-b { background: var(--bh); }
  .mt-bt { top: 0; left: 0; right: 0; height: var(--bw); }
  .mt-bb { bottom: 0; left: 0; right: 0; height: var(--bw); }
  .mt-bl, .mt-br { top: 0; bottom: 0; width: var(--bw); background: var(--bv, var(--bh)); }
  .mt-bl { left: 0; }
  .mt-br { right: 0; }
  .mt-fx { inset: var(--bw); overflow: hidden; box-shadow: var(--nl, none); }
  .mt-cart {
    top: calc(var(--bw) + 12px); right: calc(var(--bw) + 12px);
    max-width: min(20rem, calc(100% - 2 * var(--bw) - 90px));
    pointer-events: auto; animation: mt-in .7s cubic-bezier(.2, .9, .3, 1.15) both;
    color: var(--ink); background: var(--card); padding: 14px 22px 12px; text-align: center;
    border: 1px solid var(--ink);
    box-shadow: 0 0 0 3px var(--card), 0 0 0 4px var(--ink2, var(--ink)), 0 6px 18px rgba(40, 30, 12, .28);
  }
  .mt-cart .ribbon {
    display: inline-block; margin-top: 6px; padding: 2px 14px; color: var(--card); background: var(--rib, var(--ink));
    font-style: italic; font-size: 13px; clip-path: polygon(0 0, 100% 0, 94% 50%, 100% 100%, 0 100%, 6% 50%);
  }
  .mt-x {
    position: absolute; top: 4px; right: 6px; width: 22px; height: 22px; line-height: 20px;
    border: 0; background: transparent; color: inherit; opacity: .6; font-size: 18px; cursor: pointer;
  }
  .mt-x:hover, .mt-x:focus-visible { opacity: 1; }
  .mt-deco { left: calc(var(--bw) + 14px); bottom: calc(var(--bw) + 14px); }
  .mt .leaflet-top.leaflet-left .leaflet-control { margin-left: calc(var(--bw) + 8px); margin-top: calc(var(--bw) + 8px); }
  .mt .leaflet-bottom.leaflet-right .leaflet-control { margin-right: var(--bw); margin-bottom: var(--bw); }
  .mt .leaflet-tile-pane { filter: var(--tf, none); }
  .mt .leaflet-popup-content-wrapper, .mt .leaflet-popup-tip { background: #f7f1e1; }
  .mt .aspen-flag-marker img { filter: sepia(.3); }
  .mt .aspen-flag-marker.mt-hero { z-index: 1000 !important; }
  .mt .aspen-flag-marker.mt-hero > div { animation: mt-hero 1.2s cubic-bezier(.2, .9, .3, 1.2) both; transform: scale(1.35); }
  .mt .aspen-flag-marker.mt-hero img { box-shadow: 0 0 0 2px var(--accent, #3a8a6e), 0 0 14px var(--accent, #3a8a6e) !important; }
  /* while a popup is open, the cartouche and ornaments step aside */
  .mt.mt-popped .mt-cart, .mt.mt-popped .mt-deco { opacity: 0; pointer-events: none; transition: opacity .25s ease; }
  .mt-cart, .mt-deco { transition: opacity .25s ease; }
  @keyframes mt-in { from { opacity: 0; transform: translateY(-10px) scale(.96); } }
  @keyframes mt-hero { from { transform: scale(.4); } 60% { transform: scale(1.55); } to { transform: scale(1.35); } }
  /* paper grain */
  .mt-noise::after {
    content: ""; position: absolute; inset: 0; opacity: calc(var(--grain, 1) * .45);
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='220' height='220'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.75' numOctaves='3' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 .45  0 0 0 0 .32  0 0 0 0 .15  0 0 0 .22 0'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
  }
  /* East Asian maps name themselves on a vertical title slip with a seal */
  .mt-japan .mt-cart, .mt-korea .mt-cart, .mt-taiwan .mt-cart {
    display: flex; flex-direction: column; align-items: center; gap: 8px; text-align: center;
    padding: 12px 12px 10px; box-shadow: 0 6px 18px rgba(40, 30, 12, .25);
  }

  .mt .slip {
    writing-mode: vertical-rl; display: flex; align-items: center; gap: 10px; flex: none; padding: 12px 7px;
    border: 1px solid var(--ink); box-shadow: inset 0 0 0 2px var(--card), inset 0 0 0 3px var(--ink);
  }
  .mt .slip .t { line-height: 1; letter-spacing: .14em; }
  /* the note under it stays horizontal, so the English reads normally */
  .mt .slip + .k { font-size: 11px; line-height: 1.45; max-width: 11rem; }
  /* (--bh/--bv for most themes are band tiles built in the script) */

  /* ── United Kingdom: an eighteenth-century county map ─────────── */
  .mt-britain {
    --bw: 10px; --accent: #225641; --ink: #2b2116; --rib: #225641;
    --lf: "IM Fell English", Georgia, serif; --lbl: #2b2116; --halo: #efe2bf;
    --tf: sepia(.85) saturate(1.3) hue-rotate(-10deg) contrast(1.15) brightness(.98);
    --vig: rgba(112, 72, 24, .38);
    --nl: inset 0 0 0 3px #efe2bf, inset 0 0 0 4px #2b2116;
  }
  .mt-britain .mt-cart { font-family: "IM Fell English", Georgia, serif; padding: 14px 24px 12px; }
  .mt-britain .mt-cart .k { font-family: "IM Fell English SC", Georgia, serif; font-size: 12px; letter-spacing: .12em; }
  .mt-britain .mt-cart .t { font-size: 22px; line-height: 1.1; margin: 2px 0 4px; }
  .mt-britain .mt-compass { width: 96px; height: 96px; }

  /* ── Scotland: an Ordnance Survey first-edition engraving ─────── */
  .mt-scotland {
    --bw: 13px; --accent: #1f3a52; --ink: #1a1a1a; --card: #f6f4ee; --grain: .5;
    --lf: "Cormorant SC", Georgia, serif; --lbl: #1a1a1a; --halo: #f1efe8;
    --tf: grayscale(1) sepia(.2) contrast(1.3) brightness(.98);
    --vig: rgba(60, 58, 50, .22);
  }
  .mt-scotland .mt-cart .t { font-family: "Cormorant SC", Georgia, serif; font-weight: 600; font-size: 20px; line-height: 1.2; letter-spacing: .03em; margin: 6px 0 4px; }
  .mt-scotland .mt-cart .k { font: italic 12.5px/1.4 Georgia, serif; color: #3a3a3a; }

  /* ── Netherlands: a Golden Age atlas (Blaeu, Hondius) ─────────── */
  .mt-netherlands {
    --bw: 16px; --accent: #e8741f; --ink: #1d4f91; --rib: #c8661f; --card: #f6ecd2;
    --lf: "Cormorant Garamond", Georgia, serif; --lbl: #1d3f73; --halo: #f0e2c0;
    --tf: sepia(.45) saturate(1.45) hue-rotate(-8deg) contrast(1.15) brightness(.98);
    --vig: rgba(120, 80, 30, .32);
    --nl: inset 0 0 0 3px #f0e2c0, inset 0 0 0 4px #1d4f91;
  }
  .mt-netherlands .mt-cart .t { font-family: "Cormorant Garamond", Georgia, serif; font-style: italic; font-weight: 700; font-size: 28px; line-height: 1; margin: 4px 0; }
  .mt-netherlands .mt-cart .ribbon { font-size: 11px; letter-spacing: .1em; }
  .mt-netherlands .mt-compass { width: 84px; height: 84px; }

  /* ── Finland: a seventeenth-century Nordic engraving ──────────── */
  .mt-finland {
    --bw: 12px; --accent: #3d5570; --ink: #3d5570; --card: #f4f4f0; --grain: .5;
    --lf: "Cormorant Garamond", Georgia, serif; --lbl: #2c4260; --halo: #eef0f0;
    --tf: grayscale(1) sepia(.3) hue-rotate(180deg) saturate(.9) contrast(1.3) brightness(.97);
    --vig: rgba(60, 80, 105, .22);
  }
  .mt-finland .mt-cart .t { font-family: "Cormorant Garamond", Georgia, serif; font-weight: 700; font-size: 24px; line-height: 1.1; margin: 4px 0; color: #2c4260; }
  .mt-finland .mt-cart .k { font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: #5b7088; }
  .mt-finland .mt-candles { width: 40px; height: 47px; }
  .mt-finland .flame { transform-origin: 50% 100%; transform-box: fill-box; animation: mt-flicker 1.6s ease-in-out infinite alternate; }
  .mt-finland .flame.b { animation-duration: 1.3s; }
  @keyframes mt-flicker { from { transform: scale(1, 1) rotate(-2deg); } to { transform: scale(.9, 1.08) rotate(2deg); } }

  /* ── Japan: an Edo woodblock map on washi, seigaiha border ────── */
  .mt-japan {
    --bw: 20px; --accent: #bc2d29; --ink: #1f4f5c; --card: #f7f0de;
    --lf: "Shippori Mincho", serif; --lbl: #1f2a2e; --halo: #f4ecd8;
    --tf: sepia(.5) saturate(.85) contrast(1.25) brightness(.98);
   
    --bh:
      radial-gradient(circle at 100% 150%, #f4ecd8 24%, #1f4f5c 24%, #1f4f5c 28%, #f4ecd8 28%, #f4ecd8 36%, #1f4f5c 36%, #1f4f5c 40%, transparent 40%) 0 0 / 40px 20px,
      radial-gradient(circle at 0 150%, #f4ecd8 24%, #1f4f5c 24%, #1f4f5c 28%, #f4ecd8 28%, #f4ecd8 36%, #1f4f5c 36%, #1f4f5c 40%, transparent 40%) 0 0 / 40px 20px,
      radial-gradient(circle at 50% 100%, #1f4f5c 10%, #f4ecd8 10%, #f4ecd8 23%, #1f4f5c 23%, #1f4f5c 30%, #f4ecd8 30%, #f4ecd8 43%, #1f4f5c 43%, #1f4f5c 50%, #f4ecd8 50%, #f4ecd8 63%, #1f4f5c 63%, #1f4f5c 71%, transparent 71%) 0 0 / 40px 20px,
      #f4ecd8;
  }
  .mt-japan .mt-cart { color: #1f2a2e; }
  .mt-japan .slip .t { font-family: "Shippori Mincho", serif; font-weight: 700; font-size: 24px; }
  .mt-japan .mt-cart .k { color: #4c5b5f; letter-spacing: .04em; }
  .mt-japan .hanko {
    flex: none; width: 34px; height: 34px; display: grid; place-items: center; border-radius: 5px;
    background: #bc2d29; color: #f7f0de; font-family: "Shippori Mincho", serif; font-weight: 700; font-size: 20px;
  }

  /* ── Korea: a Joseon woodblock map on hanji (Daedongyeojido) ──── */
  .mt-korea {
    --bw: 16px; --accent: #b8312f; --ink: #3a3029; --card: #f5eedb;
    --lf: "Nanum Myeongjo", serif; --lbl: #22201c; --halo: #f2ead3;
    --tf: grayscale(1) sepia(.5) contrast(1.3) brightness(.97);
    --vig: rgba(90, 70, 40, .2);
    --nl: inset 0 0 0 1px #3a3029;
  }
  .mt-korea .mt-cart { color: #22201c; }
  .mt-korea .slip .t { font-family: "Nanum Myeongjo", serif; font-weight: 800; font-size: 24px; }
  .mt-korea .mt-cart .k { color: #57504a; letter-spacing: .03em; }
  .mt-korea .taegeuk { flex: none; width: 26px; height: 26px; }

  /* ── Taiwan: a Qing blue-green scroll map, mounted for hanging ── */
  .mt-taiwan {
    --bw: 18px; --accent: #9e1b1b; --ink: #2d4a3e; --card: #f3ead3;
    --lf: "LXGW WenKai TC", "Noto Serif TC", serif; --lbl: #1f2a24; --halo: #eee6cc;
    --tf: sepia(.6) hue-rotate(45deg) saturate(1.5) contrast(1.25) brightness(.97);
    --vig: rgba(70, 80, 50, .22);
    --bh: #d3dbc8; --nl: inset 0 0 0 1px #6d7f68, inset 0 0 0 3px #efe7d0, inset 0 0 0 4px #6d7f68;
  }
  /* silk mounting: a thin wooden rod along the top, the roller with its knobs along the bottom */
  .mt-taiwan .mt-bt, .mt-taiwan .mt-bb { z-index: 1; }
  .mt-taiwan .mt-bt { background: linear-gradient(#5b4030, #5b4030) 0 0 / 100% 4px no-repeat, #d3dbc8; }
  .mt-taiwan .mt-bb {
    background:
      linear-gradient(#3b2a1f, #3b2a1f) 0 100% / 14px 9px no-repeat,
      linear-gradient(#3b2a1f, #3b2a1f) 100% 100% / 14px 9px no-repeat,
      linear-gradient(#5b4030, #5b4030) 0 100% / 100% 6px no-repeat,
      #d3dbc8;
  }
  .mt-taiwan .mt-cart { color: #1f2a24; }
  .mt-taiwan .slip .t { font-family: "LXGW WenKai TC", "Noto Serif TC", serif; font-weight: 700; font-size: 25px; }
  .mt-taiwan .mt-cart .k { color: #4a5a50; }
  .mt-taiwan .seal {
    flex: none; width: 30px; height: 30px; display: grid; place-items: center; border-radius: 3px;
    background: #9e1b1b; color: #f3ead3; font-family: "LXGW WenKai TC", serif; font-weight: 700; font-size: 12px; line-height: 1;
  }

  /* ── Hong Kong: an Admiralty chart, for the Cheung Chau Bun Festival ── */
  .mt-hongkong {
    --bw: 14px; --accent: #b3261e; --ink: #1c1c1c; --card: #f7f7f2; --grain: .5;
    --lf: "Libre Caslon Text", "Noto Serif HK", Georgia, serif; --lbl: #1c1c1c; --halo: #eef1f2;
    --tf: grayscale(.5) sepia(.12) contrast(1.15) brightness(1);
    --vig: rgba(60, 75, 85, .18);
  }
  .mt-hongkong .mt-cart { padding: 12px 22px 10px; }
  .mt-hongkong .mt-cart .en { font: 700 14px/1.25 "Libre Caslon Text", Georgia, serif; letter-spacing: .12em; }
  .mt-hongkong .mt-cart .t { font-family: "Noto Serif HK", serif; font-weight: 700; font-size: 20px; line-height: 1.3; letter-spacing: .2em; margin: 4px 0 6px; }
  .mt-hongkong .mt-cart .k { font: italic 11.5px/1.4 "Libre Caslon Text", Georgia, serif; color: #3a3a3a; padding-top: 6px; border-top: 1px solid #1c1c1c; }
  .mt-hongkong .mt-bunshan { width: 70px; height: 100px; }

  /* ── Thailand: gold on lacquer, after the samut khoi ──────────── */
  .mt-thailand {
    --bw: 16px; --accent: #c9a14a; --ink: #c9a14a; --card: #231b17;
    --lf: Georgia, "Noto Serif Thai", serif; --lbl: #3b2a12; --halo: #efe0bb;
    --tf: sepia(.7) saturate(1.25) hue-rotate(-4deg) contrast(1.12) brightness(.98);
    --vig: rgba(110, 60, 10, .32);
    --nl: inset 0 0 0 1px #c9a14a;
  }
  .mt-thailand .mt-cart { color: #d9bb72; }
  .mt-thailand .mt-cart .t { font-family: "Noto Serif Thai", serif; font-weight: 700; font-size: 26px; line-height: 1.2; color: #e2c57f; }
  .mt-thailand .mt-cart .k { font-size: 11px; letter-spacing: .12em; text-transform: uppercase; margin-top: 2px; }

  /* ── Australia: a VOC chart of Hollandia Nova ─────────────────── */
  .mt-australia {
    --bw: 16px; --accent: #1f5c47; --ink: #1f5c47; --ink2: #b08a2e;
    --lf: Georgia, serif; --lbl: #3d2e1c; --halo: #efe2bf;
    --tf: sepia(.9) saturate(1.2) hue-rotate(-8deg) contrast(1.12) brightness(.98);
    --vig: rgba(112, 72, 24, .4);
    --nl: inset 0 0 0 3px #efe2bf, inset 0 0 0 4px #5a4630;
  }
  .mt-australia .mt-fx svg { display: block; }
  .mt-australia .mt-cart .t { font-family: "Playfair Display", Georgia, serif; font-weight: 800; font-size: 22px; }
  .mt-australia .mt-cart .k { font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: #5a4a36; margin-top: 2px; }
  .mt-australia .mt-cross { width: 60px; height: 72px; }

  /* ── United States: an 1890s atlas plate ──────────────────────── */
  .mt-usa {
    --bw: 14px; --accent: #9b3a3f; --ink: #1c2e5a; --card: #f6f0e0;
    --lf: "Old Standard TT", Georgia, serif; --lbl: #1c2e5a; --halo: #f3ecd8;
    --tf: sepia(.3) saturate(.9) hue-rotate(-8deg) contrast(1.08) brightness(1);
    --vig: rgba(100, 80, 40, .18);
  }
  .mt-usa .mt-cart .stars { color: #9b3a3f; font-size: 9px; letter-spacing: .7em; margin-left: .7em; }
  .mt-usa .mt-cart .t {
    display: inline-block; margin: 5px 0 4px; padding: 3px 26px; background: #1c2e5a; color: #f6f0e0;
    font: italic 700 19px/1.2 "Old Standard TT", Georgia, serif; clip-path: polygon(0 0, 100% 0, 95% 50%, 100% 100%, 0 100%, 5% 50%);
  }
  .mt-usa .mt-cart .k { font-size: 11px; letter-spacing: .14em; text-transform: uppercase; }

  /* phones: the cartouche runs along the bottom, full width, and the
     corner ornaments step out, so nothing is squeezed to one glyph a line */
  @media (max-width: 560px) {
    .mt .mt-cart {
      top: auto; bottom: calc(var(--bw) + 30px);
      left: calc(var(--bw) + 10px); right: calc(var(--bw) + 10px); max-width: none;
    }
    .mt .slip { writing-mode: horizontal-tb; }
    .mt .slip { padding: 7px 12px; }
    .mt-japan .mt-cart, .mt-korea .mt-cart, .mt-taiwan .mt-cart { gap: 6px; }
    .mt .slip .t { font-size: 20px; }
    .mt-hongkong .mt-cart, .mt-usa .mt-cart { bottom: calc(var(--bw) + 44px); }
    .mt .mt-deco { display: none; }
    .mt .mt-plate { left: auto; bottom: auto; right: calc(var(--bw) + 8px); top: calc(var(--bw) + 8px); width: 86px; padding: 3px; }
    .mt .mt-plate img { max-height: 110px; }
    .mt .mt-plate span { display: none; }
  }

  /* a short notice */
  .mt-toast {
    position: absolute; left: 50%; bottom: calc(var(--bw, 0px) + 12px); transform: translateX(-50%); z-index: 460;
    padding: 4px 10px; border-radius: 999px; background: rgba(16, 36, 32, .85); color: #e2eeeb;
    font: 600 11px Inter, system-ui, sans-serif; letter-spacing: .04em; pointer-events: none;
    animation: mt-in .4s ease both;
  }

  /* the period map itself, as a small framed plate in the corner */
  .mt-plate {
    left: calc(var(--bw) + 12px); bottom: calc(var(--bw) + 12px); width: 150px; padding: 5px 5px 4px;
    pointer-events: auto; cursor: zoom-in; border: 1px solid var(--ink); background: var(--card);
    box-shadow: 0 0 0 2px var(--card), 0 0 0 3px var(--ink), 0 5px 14px rgba(40, 30, 12, .3);
    transition: transform .2s ease, opacity .25s ease;
  }
  .mt-plate:hover, .mt-plate:focus-visible { transform: translateY(-2px); }
  .mt-plate img { display: block; width: 100%; max-height: 180px; object-fit: contain; }
  .mt-plate span { display: block; margin-top: 3px; font: italic 10.5px/1.25 Georgia, serif; color: var(--ink); text-align: center; }
  .mt.mt-popped .mt-plate { opacity: 0; pointer-events: none; }
  .mt-light {
    position: fixed; inset: 0; z-index: 60; display: flex; align-items: center; justify-content: center;
    padding: 2.5rem 1rem 1rem; background: rgba(20, 16, 10, .88); cursor: zoom-out;
  }
  .mt-light figure { margin: 0; max-width: min(1600px, 100%); max-height: 100%; display: flex; flex-direction: column; align-items: center; }
  .mt-light img { max-width: 100%; max-height: calc(100vh - 7rem); object-fit: contain; box-shadow: 0 10px 40px rgba(0, 0, 0, .5); }
  .mt-light figcaption { margin-top: .7rem; color: #efe6cf; font: 13px/1.45 Georgia, serif; text-align: center; }
  .mt-light figcaption a { color: #f4e285; margin-left: .4rem; }
  .mt-light-x {
    position: fixed; top: .75rem; right: .9rem; width: 2.5rem; height: 2.5rem; border-radius: 999px;
    border: 1px solid rgba(239, 230, 207, .35); background: transparent; color: #efe6cf; font: 400 1.6rem/1 system-ui, sans-serif; cursor: pointer;
  }

  /* place names, lettered like the period map */
  .mt-lbl { pointer-events: none; }
  .mt-lbl span {
    position: absolute; transform: translate(-50%, -50%); white-space: nowrap; line-height: 1;
    font-family: var(--lf, Georgia, serif); color: var(--lbl, var(--ink));
    text-shadow: 0 0 2px var(--halo, #f4ead2), 0 0 3px var(--halo, #f4ead2), 0 0 6px var(--halo, #f4ead2);
  }
  .mt-lbl.city span, .mt-lbl.cap span { transform: translate(-4px, -50%); font-size: 12.5px; }
  .mt-lbl.cap span { font-size: 14.5px; font-weight: 700; letter-spacing: .03em; }
  .mt-lbl i {
    display: inline-block; width: 5px; height: 5px; margin-right: 5px; vertical-align: 1px;
    border: 1.2px solid currentColor; border-radius: 50%; background: var(--halo, #f4ead2);
  }
  .mt-lbl.cap span.under { transform: translate(-50%, 21px); }
  .mt-lbl.cap span.under i { display: none; }
