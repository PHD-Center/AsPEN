          [[25, 8.6], [30.5, 6.8], [35.5, 5.4], [40, 3.9], [44.5, 4.6]].map(([x, y]) => `<circle cx='${x}' cy='${y}' r='1.5'/>`).join("") + `</g>`),
        cart: (c) => `<div class="t">Australia Day</div><div class="k">26 January · ${n(c)}</div>`,
        // rhumb lines out of a small rose, as on a portolan
        fx: () => {
          let s = "";
